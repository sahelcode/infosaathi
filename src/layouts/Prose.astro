---
// Layout for the policy and information pages (about, verification, contact, privacy, terms ...).
import Base from './Base.astro';
import { SITE, UPDATED } from '../lib/site';
import '../styles/prose.css';

interface Props {
  title: string;       // page title (without the site name)
  description: string;
  path: string;        // e.g. /about/
  kicker: string;
  lead: string;
  type?: 'WebPage' | 'AboutPage' | 'ContactPage';
  toc?: { id: string; label: string }[];
  showDate?: boolean;
  noindex?: boolean;
}
const { title, description, path, kicker, lead, type = 'WebPage', toc = [], showDate = true, noindex = false } = Astro.props;
const url = SITE + path;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': type, '@id': url + '#page', url, name: title, description, inLanguage: 'bn', isPartOf: { '@type': 'WebSite', name: 'InfoSaathi', url: SITE + '/' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'হোম', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ] },
  ],
};
---
<Base title={`${title} | InfoSaathi`} description={description} path={path} jsonld={jsonld} noindex={noindex}>
  <main class="ps">
    <div class="ps-wrap">
      <nav class="ps-crumb" aria-label="breadcrumb"><a href="/">হোম</a> › <span>{title}</span></nav>
      <header class="ps-head">
        <span class="ps-kicker">{kicker}</span>
        <h1>{title}</h1>
        <p class="ps-lead">{lead}</p>
        {showDate && <p class="ps-meta">সর্বশেষ হালনাগাদ: {UPDATED}</p>}
      </header>
      {toc.length > 1 && (
        <nav class="ps-toc" aria-label="সূচিপত্র"><b>এই পাতায় যা আছে</b>
          <ol>{toc.map((t) => <li><a href={'#' + t.id}>{t.label}</a></li>)}</ol>
        </nav>
      )}
      <article class="ps-body"><slot /></article>
    </div>
  </main>
</Base>
