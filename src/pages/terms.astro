---
import Prose from '../layouts/Prose.astro';
import { CONTACT_EMAIL } from '../lib/site';
const toc = [
  { id: 'grohon', label: 'শর্ত গ্রহণ' },
  { id: 'sheba', label: 'আমাদের সেবা' },
  { id: 'byabohar', label: 'ব্যবহারের নিয়ম' },
  { id: 'tothyo', label: 'তথ্যের নির্ভুলতা' },
  { id: 'bouddhik', label: 'বুদ্ধিবৃত্তিক সম্পদ' },
  { id: 'link', label: 'বাইরের লিংক' },
  { id: 'dayitto', label: 'দায়বদ্ধতার সীমা' },
  { id: 'poribortan', label: 'পরিবর্তন ও আইন' },
];
---
<Prose title="ব্যবহারের শর্ত" description="InfoSaathi ওয়েবসাইট ব্যবহারের শর্তাবলি: সেবার পরিধি, ব্যবহারের নিয়ম, তথ্যের নির্ভুলতা, বুদ্ধিবৃত্তিক সম্পদ ও দায়বদ্ধতার সীমা।" path="/terms/" kicker="নীতিমালা" toc={toc}
  lead="InfoSaathi ব্যবহার করলে আপনি নিচের শর্তগুলো মেনে নিচ্ছেন বলে ধরা হবে। অনুগ্রহ করে মনোযোগ দিয়ে পড়ুন।">

  <h2 id="grohon">শর্ত গ্রহণ</h2>
  <p>এই ওয়েবসাইট (infosaathi.com) ঘুরে দেখা বা ব্যবহার করার মাধ্যমে আপনি এই শর্তাবলি এবং আমাদের <a href="/privacy/">গোপনীয়তা নীতি</a> ও <a href="/disclaimer/">চিকিৎসা তথ্যের দায়মুক্তি</a> মেনে নিচ্ছেন। শর্তে সম্মত না হলে অনুগ্রহ করে সাইট ব্যবহার করবেন না।</p>

  <h2 id="sheba">আমাদের সেবা</h2>
  <p>InfoSaathi একটি তথ্যভিত্তিক সাইট। এটি চিকিৎসা সেবা প্রদানকারী নয়, ডাক্তারের সিরিয়াল বুকিংয়ের প্ল্যাটফর্ম নয় এবং কোনো ডাক্তার বা প্রতিষ্ঠানের প্রতিনিধিও নয়। আমরা সাধারণ তথ্য সাজিয়ে প্রকাশ করি, যাতে আপনি নিজে সিদ্ধান্ত নিতে পারেন।</p>

  <h2 id="byabohar">ব্যবহারের নিয়ম</h2>
  <p>সাইট ব্যবহারের সময় আপনি রাজি হচ্ছেন যে আপনি:</p>
  <ul>
    <li>সাইটটি শুধু আইনসম্মত উদ্দেশ্যে ব্যবহার করবেন।</li>
    <li>স্বয়ংক্রিয় প্রোগ্রাম দিয়ে অতিরিক্ত অনুরোধ পাঠিয়ে সাইটের কাজে বাধা দেবেন না।</li>
    <li>ডাক্তার বা ডাক্তারের সহকারীকে বিরক্ত, হয়রানি বা প্রতারণার জন্য এখানকার ফোন নম্বর ব্যবহার করবেন না।</li>
    <li>ভুয়া তথ্য, অভিযোগ বা অন্যের পরিচয় ব্যবহার করে সংশোধনের অনুরোধ পাঠাবেন না।</li>
    <li>আমাদের অনুমতি ছাড়া সাইটের বিষয়বস্তু বড় আকারে কপি করে অন্যত্র প্রকাশ বা বাণিজ্যিক কাজে ব্যবহার করবেন না।</li>
  </ul>

  <h2 id="tothyo">তথ্যের নির্ভুলতা</h2>
  <p>আমরা যথাসাধ্য নির্ভুল ও হালনাগাদ তথ্য দেওয়ার চেষ্টা করি এবং প্রতিটি তথ্যের সঙ্গে যাচাইয়ের তারিখ জানাই। তবুও চেম্বারের সময়, ফি, ঠিকানা ও ফোন নম্বর যেকোনো সময় বদলাতে পারে। তাই কোনো তথ্যের নির্ভুলতা বা পূর্ণতা সম্পর্কে আমরা চূড়ান্ত নিশ্চয়তা দিতে পারি না। গুরুত্বপূর্ণ সিদ্ধান্তের আগে সরাসরি সংশ্লিষ্ট চেম্বারে যোগাযোগ করে নিন। আমাদের যাচাই পদ্ধতি জানতে দেখুন <a href="/verification/">তথ্য যেভাবে যাচাই করি</a>।</p>

  <h2 id="bouddhik">বুদ্ধিবৃত্তিক সম্পদ</h2>
  <p>সাইটের নকশা, লেখা, লোগো ও কাঠামো InfoSaathi-র সম্পদ। ব্যক্তিগত, অবাণিজ্যিক ব্যবহারে এবং উৎস হিসেবে আমাদের নাম উল্লেখ করে সামান্য অংশ উদ্ধৃত করা যাবে। ডাক্তার, হাসপাতাল বা অন্য প্রতিষ্ঠানের নাম, ছবি ও কার্ডের স্বত্ব সংশ্লিষ্ট মালিকের। কোনো বিষয়বস্তু নিয়ে আপনার আপত্তি থাকলে <a href={`mailto:${CONTACT_EMAIL}`}>ইমেইলে</a> জানালে আমরা দ্রুত দেখব।</p>

  <h2 id="link">বাইরের লিংক</h2>
  <p>সাইটে অন্য ওয়েবসাইটের (যেমন মানচিত্র বা সরকারি সাইট) লিংক থাকতে পারে। সেসব সাইটের বিষয়বস্তু বা নীতির ওপর আমাদের নিয়ন্ত্রণ নেই এবং এর দায়ও আমরা নিই না।</p>

  <h2 id="dayitto">দায়বদ্ধতার সীমা</h2>
  <p>আইনে অনুমোদিত সর্বোচ্চ সীমা পর্যন্ত InfoSaathi এবং এর পরিচালকরা সাইটের তথ্যের ওপর নির্ভর করে নেওয়া কোনো সিদ্ধান্ত থেকে সৃষ্ট ক্ষতি, অসুবিধা বা অপচয়ের জন্য দায়ী থাকবেন না। চিকিৎসা-সংক্রান্ত দায়মুক্তির বিস্তারিত রয়েছে <a href="/disclaimer/">আলাদা পাতায়</a>। এই সাইটের মাধ্যমে ডাক্তারের চিকিৎসা, আচরণ বা সেবার মানের দায় আমরা বহন করি না।</p>

  <h2 id="poribortan">পরিবর্তন ও আইন</h2>
  <p>প্রয়োজনে আমরা এই শর্ত বদলাতে পারি। বদলের পর সাইট ব্যবহার চালিয়ে গেলে নতুন শর্ত মেনে নেওয়া হয়েছে বলে ধরা হবে। এই শর্তাবলি বাংলাদেশের প্রচলিত আইন অনুযায়ী ব্যাখ্যা ও প্রয়োগ করা হবে। প্রশ্ন থাকলে লিখুন: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>।</p>
</Prose>
