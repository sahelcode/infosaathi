---
// Hospital page. Data from one file in src/content/hospitals/; the doctor list is filled automatically
// from every doctor file whose chamber names this hospital.
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import NumRow from '../../../components/NumRow.astro';
import Faq from '../../../components/Faq.astro';
import Report from '../../../components/Report.astro';
import ShareRow from '../../../components/ShareRow.astro';
import Ad from '../../../components/Ad.astro';
import MiniDoctor from '../../../components/MiniDoctor.astro';
import HospitalCover from '../../../components/HospitalCover.astro';
import { getDoctors, getHospitals, hospitalUrl, doctorsAt, type Hospital } from '../../../lib/data';
import { CITIES, SPECIALTIES, FACILITIES, TEST_GROUPS } from '../../../lib/taxonomy';
import { bn, taka, phoneShow, phoneIntl, daysText, timeRange, bnDate, bnMonth, isoDay } from '../../../lib/format';
import { SITE } from '../../../lib/site';
import '../../../styles/hospital.css';
import '../../../styles/uni.css';

export async function getStaticPaths() {
  const hospitals = await getHospitals();
  return hospitals.map((h) => ({ params: { city: h.data.city, slug: h.id }, props: { hospital: h } }));
}

const { hospital } = Astro.props as { hospital: Hospital };
const h = hospital.data;
const city = CITIES[h.city];
const short = h.short ?? h.name;
const path = hospitalUrl(hospital);
const map = h.map ?? `https://maps.google.com/?q=${encodeURIComponent(h.name_en + ', ' + city.en)}`;

const er = h.numbers.find((n) => n.kind === 'emergency');
const serial = h.numbers.find((n) => n.kind === 'serial') ?? h.numbers[0];
const single = !er && h.numbers.length === 1; // one number: call it directly, no list needed

// doctors who have a chamber here, with their schedule at this hospital
const doctors = doctorsAt(await getDoctors(), hospital.id).map((d) => {
  const c = d.data.chambers.find((x) => x.hospital?.id === hospital.id)!;
  return { d, when: c.days && c.start && c.end ? `${daysText(c.days)} · ${timeRange(c.start, c.end)}` : 'সময় যাচাই বাকি' };
});
const spCount = new Map<string, number>();
doctors.forEach(({ d }) => spCount.set(d.data.specialty, (spCount.get(d.data.specialty) ?? 0) + 1));
const spChips = [...spCount].sort((a, b) => b[1] - a[1]);

// Common items shown with "যুক্ত হয়নি" until the hospital's own price list is added.
const DEFAULT_TESTS = [
  { group: 'lab', name: 'সিবিসি (রক্তের পূর্ণাঙ্গ পরীক্ষা)', name_en: 'CBC' },
  { group: 'lab', name: 'ব্লাড সুগার', name_en: 'Blood Sugar' },
  { group: 'lab', name: 'লিপিড প্রোফাইল', name_en: 'Lipid Profile' },
  { group: 'imaging', name: 'বুকের এক্স-রে', name_en: 'X-Ray Chest' },
  { group: 'imaging', name: 'আল্ট্রাসনোগ্রাম (পুরো পেট)', name_en: 'USG Whole Abdomen' },
  { group: 'heart', name: 'ইসিজি', name_en: 'ECG' },
] as { group: keyof typeof TEST_GROUPS; name: string; name_en?: string; price?: number }[];
const testRows = h.tests.length ? h.tests : DEFAULT_TESTS;
const rateRows = h.rates; // only room types the hospital really has; no defaults
const testsKnown = testRows.some((x) => x.price);
const groups = Object.entries(TEST_GROUPS).filter(([k]) => testRows.some((t) => t.group === k));
const NOT_ADDED = 'যুক্ত হয়নি';
const NA = 'আমরা সঠিক তথ্য পাইনি';
const RATE_GROUPS = { cabin: 'ওয়ার্ড, কেবিন ও রুম', icu: 'আইসিইউ ও ক্রিটিক্যাল কেয়ার', other: 'অন্যান্য' } as const;
const rateGroups = (Object.keys(RATE_GROUPS) as (keyof typeof RATE_GROUPS)[]).map((k) => [k, rateRows.filter((r) => r.group === k)] as const).filter(([, rs]) => rs.length);
const rateRange = (g: string) => { const ps = rateRows.filter((r) => r.group === g && r.price).map((r) => r.price as number); return ps.length ? (Math.min(...ps) === Math.max(...ps) ? taka(ps[0]) : `${taka(Math.min(...ps))} থেকে ${taka(Math.max(...ps))}`) : ''; };
const q = h.quick ?? {};
const glance = [
  { k: 'বেড (শয্যা)', v: q.beds ?? (h.beds ? `${bn(h.beds)}টি` : '') },
  { k: 'আইসিইউ ও ক্রিটিক্যাল কেয়ার', v: q.icu ?? (h.icu_beds ? `${bn(h.icu_beds)}টি আইসিইউ বেড` : '') },
  { k: 'জরুরি বিভাগ', v: q.emergency ?? (h.emergency_24h ? '২৪ ঘণ্টা খোলা' : '') },
  { k: 'অ্যাম্বুলেন্স', v: q.ambulance ?? '' },
  { k: 'বিশেষজ্ঞ ডাক্তার', v: q.doctors ?? (doctors.length ? `${bn(doctors.length)} জন (আমাদের তালিকায়)` : '') },
  { k: 'রোগী দেখার সময়', v: q.visiting ?? h.visiting_hours ?? 'ডাক্তারের সময় অনুযায়ী' },
  { k: 'পরীক্ষা ও স্ক্যান', v: q.diagnostics ?? '' },
];

const faq = [
  { q: `${short}-এর যোগাযোগ নম্বর ও হটলাইন নাম্বার কী?`, a: h.numbers.map((n) => `${n.label} ${phoneShow(n.number)}${n.note ? ' (' + n.note + ')' : ''}`).join('; ') + '।' },
  { q: `${h.name}-এ ডাক্তারের সিরিয়াল কীভাবে নেব?`, a: `${phoneShow(serial.number)} নম্বরে ${serial.note ? serial.note + ' ' : ''}কল করে সিরিয়াল নিন।` },
  { q: `${h.name} কোথায়?`, a: `${h.address}।` },
  ...(h.emergency_24h ? [{ q: 'জরুরি বিভাগ কি ২৪ ঘণ্টা খোলা?', a: `হ্যাঁ, জরুরি বিভাগ ২৪ ঘণ্টা খোলা থাকে।${er ? ` জরুরি নম্বর ${phoneShow(er.number)}।` : ` যোগাযোগের নম্বর ${phoneShow(serial.number)}।`}` }] : []),
  { q: `${short}-এ রোগী দেখার (ভিজিটিং) সময় কখন?`, a: h.visiting_hours ? `${h.visiting_hours}।` : `চিকিৎসকের সময় অনুযায়ী। প্রতিটি ডাক্তারের বসার দিন ও সময় আলাদা, তাই সিরিয়াল নেওয়ার আগে ${phoneShow(serial.number)} নম্বরে ফোন করে জেনে নিন।` },
  ...(doctors.length ? [{ q: `${h.name}-এ কোন কোন বিশেষজ্ঞ ডাক্তার বসেন?`, a: spChips.map(([k, n]) => `${SPECIALTIES[k as keyof typeof SPECIALTIES].bn} (${bn(n)} জন)`).join(', ') + '।' }] : []),
  ...h.faq,
  // questions people search a lot; honest "not found" until the hospital publishes the figure
  ...(h.faq.some((f) => /পরীক্ষার ফি|টেস্টের/.test(f.q)) ? [] : [{ q: `${short}-এ পরীক্ষার (টেস্টের) ফি কত?`, a: testsKnown ? `${short}-এর পরীক্ষার ফির তালিকা এই পেজের "পরীক্ষার ফি" অংশে আছে।${h.tests_updated ? ` তালিকা হালনাগাদ: ${bnMonth(h.tests_updated)}।` : ''} ফি বদলাতে পারে, পরীক্ষার আগে হাসপাতালে জেনে নিন।` : `${short}-এর পরীক্ষার ফির সঠিক তথ্য আমরা এখনো পাইনি। হালনাগাদ ফি জানতে ${phoneShow(serial.number)} নম্বরে ফোন করুন।` }]),
  ...(h.faq.some((f) => /কেবিন|বেড ভাড়া|সিট ভাড়া/.test(f.q)) ? [] : [{ q: `${short}-এ কেবিন বা বেডের ভাড়া কত?`, a: rateRange('cabin') ? `${short}-এর কেবিন ও বেডের ভাড়া ${rateRange('cabin')} (প্রতিটির হিসাব এই পেজের খরচের তালিকায় আছে)। ভাড়া বদলাতে পারে, ভর্তির আগে ${phoneShow(serial.number)} নম্বরে জেনে নিন।` : `${short}-এর কেবিন ও বেড ভাড়ার সঠিক তথ্য আমরা এখনো পাইনি। হাসপাতালের সাথে যোগাযোগ করুন: ${phoneShow(serial.number)}।` }]),
  ...(h.faq.some((f) => /আইসিইউ.*খরচ|আইসিইউ.*ভাড়া|ICU.*(খরচ|ভাড়া)/.test(f.q)) ? [] : [{ q: `${short}-এ আইসিইউ-র খরচ কত?`, a: rateRange('icu') ? `${short}-এ আইসিইউ ও ক্রিটিক্যাল কেয়ারের খরচ ${rateRange('icu')} (ইউনিটভেদে আলাদা, এই পেজের খরচের তালিকায় দেখুন)। বদলাতে পারে, জানতে ${phoneShow(serial.number)} নম্বরে ফোন করুন।` : `${short}-এর আইসিইউ খরচের সঠিক তথ্য আমরা এখনো পাইনি। প্রতিদিনের খরচ জানতে ${phoneShow(serial.number)} নম্বরে ফোন করুন।` }]),
];

const near = (await getHospitals()).filter((x) => x.data.city === h.city && x.id !== hospital.id).slice(0, 3);

const photo = h.photo ? await getImage({ src: h.photo, width: 1200, format: 'webp' }) : undefined;
const title = `${h.name} (${h.name_en}) | ডাক্তার, সিরিয়াল, যোগাযোগ নম্বর`;
const description = `${h.name} (${h.name_en}), ${h.address}। ডাক্তারের তালিকা ও সিরিয়াল নম্বর', পরীক্ষার ফি'${h.facilities.length ? ', সুবিধা' : ''}${er ? ' ও জরুরি নম্বর' : ''}।`;
const crumbs = [['হোম', '/'], ['হাসপাতাল', '/hospitals/'], [city.bn, `/hospitals/${h.city}/`]];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Hospital',
      name: h.name_en,
      alternateName: [h.name],
      url: SITE + path,
      telephone: phoneIntl(serial.number),
      ...(h.beds && { numberOfBeds: h.beds }),
      ...(photo && { image: new URL(photo.src, SITE).href }),
      address: { '@type': 'PostalAddress', streetAddress: h.address, addressLocality: city.en, addressCountry: 'BD' },
    },
    { '@type': 'WebPage', url: SITE + path, name: title, description, inLanguage: 'bn', ...(h.verified && { dateModified: isoDay(h.verified) }) },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + u })) },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
import MiniThumb from '../../../components/MiniThumb.astro';
---
<Base title={title} description={description} path={path} ogImage={photo?.src} jsonld={jsonld} draft={h.draft} noindex={h.name_en.startsWith('Example')}>
  <main class="pf un-page">
    <nav class="pf-crumbs" aria-label="ব্রেডক্রাম্ব">
      {crumbs.map(([n, u]) => (<><a href={u}>{n}</a><span>›</span></>))}<a href={path}>{short}</a>
    </nav>
    <div class="pf-grid">
      <article class="pf-main">
        <section class="pf-hero hp-hero">
          <div class:list={['hp-cover', { 'has-photo': h.photo }]}>
            {h.photo ? <Image src={h.photo} alt={h.name} width={Math.min(1200, h.photo.width)} loading="eager" fetchpriority="high" /> : <HospitalCover />}
          </div>
          <div class="pf-hero-body no-logo">
            <h1 class="pf-name">{h.name}</h1>
            <p class="pf-en">{h.name_en}</p>
            <p class="hp-addr">{h.address}</p>
            <p class="hp-meta">{h.type} হাসপাতাল{h.emergency_24h && ' · ২৪/৭ জরুরি'}{h.certification && ` · ${h.certification}`}</p>
          </div>
          <div class="pf-actions hp-actions un-actions no-logo">
            {single ? <a class="pf-btn" href={`tel:${serial.number}`}><Icon name="phone" />কল করুন</a>
                    : <button class="pf-btn" type="button" data-sheet-open="numbers"><Icon name="phone" />কল করুন</button>}
            <a class="pf-btn" href={map} target="_blank" rel="noopener" aria-label="ম্যাপ"><Icon name="pin" /></a>
            <button class="pf-btn" type="button" data-share aria-label="শেয়ার"><Icon name="share" /></button>
          </div>
        </section>

        {h.about && <p class="hp-about">{h.about}</p>}

        <section class="un-fact" aria-labelledby="h-fact"><h2 id="h-fact">এক নজরে</h2>
          <dl>{glance.map((g) => <div class:list={['un-row', { na: !g.v }]}><dt>{g.k}</dt><dd>{g.v || NA}</dd></div>)}</dl>
        </section>

        <section class="un-fact" aria-labelledby="h-nums"><h2 id="h-nums">যোগাযোগের নম্বর</h2>
          <div class="pf-nums hp-nums">{h.numbers.map((n) => <NumRow label={n.label} number={n.number} note={n.note} er={n.kind === 'emergency'} />)}</div>
        </section>

        {doctors.length > 0 && (
          <section class="pf-card" id="doctors" aria-labelledby="h-docs">
            <div class="pf-card-head"><h2 id="h-docs">এই হাসপাতালের ডাক্তার</h2><span class="pf-count">{bn(doctors.length)} জন</span></div>
            {spChips.length > 1 && (
              <div class="hp-chips" role="tablist" aria-label="বিশেষজ্ঞতা">
                <button class="hp-chip on" type="button" data-spec="all">সব<span>{bn(doctors.length)}</span></button>
                {spChips.map(([k, n]) => <button class="hp-chip" type="button" data-spec={k}>{SPECIALTIES[k as keyof typeof SPECIALTIES].bn}<span>{bn(n)}</span></button>)}
              </div>
            )}
            <div class="hp-docs">{doctors.map(({ d, when }) => <MiniDoctor doctor={d} place={when} cls="hp-doc" clock />)}</div>
          </section>
        )}

        {h.facilities.length > 0 && (
          <section class="pf-card" id="facilities" aria-labelledby="h-fac">
            <div class="pf-card-head"><h2 id="h-fac">সুবিধাসমূহ</h2></div>
            <ul class="hp-facs">{h.facilities.map((f) => <li class="hp-fac"><span class="hp-fac-i"><Icon facility={f} size={20} w={1.8} /></span><span>{FACILITIES[f]}</span></li>)}</ul>
          </section>
        )}

        {testRows.length > 0 && (
          <section class="pf-card" id="fees" aria-labelledby="h-fees">
            <div class="pf-card-head"><h2 id="h-fees">পরীক্ষার ফি</h2>{h.tests_updated && <span class="pf-count">হালনাগাদ: {bnMonth(h.tests_updated)}</span>}</div>
            <label class="hp-search"><Icon name="search" w={2.2} /><input type="search" placeholder="পরীক্ষার নাম লিখুন, যেমন CBC" data-fee-q enterkeyhint="search" /></label>
            {groups.length > 1 && (
              <div class="hp-chips">
                <button class="hp-chip on" type="button" data-feetab="all">সব</button>
                {groups.map(([k, t]) => <button class="hp-chip" type="button" data-feetab={k}>{t}</button>)}
              </div>
            )}
            <ul class="hp-fees">
              {testRows.map((t) => (
                <li class="hp-fee" data-cat={t.group} data-q={(t.name + ' ' + (t.name_en ?? '')).toLowerCase()}>
                  <span><b>{t.name}</b>{t.name_en && <small>{t.name_en}</small>}</span><strong class:list={{ na: !t.price }}>{t.price ? taka(t.price) : NOT_ADDED}</strong>
                </li>
              ))}
            </ul>
            <p class="hp-empty" data-fee-empty hidden>এই নামে কোনো পরীক্ষা পাওয়া যায়নি</p>
            <p class="pf-note">{testsKnown ? 'ফি পরিবর্তন হতে পারে। পরীক্ষা করানোর আগে হাসপাতালে জেনে নিন।' : 'এই হাসপাতালের ফি আমরা এখনো যুক্ত করিনি। জানতে হাসপাতালে ফোন করুন।'}</p>
          </section>
        )}

        {rateGroups.length > 0 && (
          <section class="pf-card" id="rates" aria-labelledby="h-rates">
            <div class="pf-card-head"><h2 id="h-rates">কেবিন, বেড ও আইসিইউ খরচ</h2>{h.rates_updated && <span class="pf-count">হালনাগাদ: {bnMonth(h.rates_updated)}</span>}</div>
            {rateGroups.map(([k, rs]) => (
              <div class="hp-rate-grp">
                <h3>{RATE_GROUPS[k]}</h3>
                <ul class="hp-fees">{rs.map((r) => <li class="hp-fee"><span><b>{r.name}</b>{r.note && <small>{r.note}</small>}</span><strong class:list={{ na: !r.price }}>{r.price ? <>{taka(r.price)}<small class="hp-unit">{r.unit ?? 'প্রতিদিন'}</small></> : NOT_ADDED}</strong></li>)}</ul>
              </div>
            ))}
            <p class="pf-note">ভাড়া ও খরচ বদলাতে পারে। ভর্তির আগে হাসপাতালে জেনে নিন।</p>
          </section>
        )}

        <Ad />

        <section class="pf-card" id="visit" aria-labelledby="h-visit">
          <h2 id="h-visit">ঠিকানা ও সময়</h2>
          <div class="hp-info">
            <div><span class="pf-k">ঠিকানা</span><b>{h.address}</b></div>
            {h.visiting_hours && <div><span class="pf-k">রোগী দেখার (ভিজিটিং) সময়</span><b>{h.visiting_hours}</b></div>}
            {h.emergency_24h && <div><span class="pf-k">জরুরি বিভাগ</span><b>২৪ ঘণ্টা খোলা</b></div>}
          </div>
          <a class="pf-btn hp-mapbtn" href={map} target="_blank" rel="noopener"><Icon name="pin" />Google Maps-এ দেখুন</a>
          <p class="un-checked"><Icon name="clock" size={13} w={2.2} />{h.verified_by === 'phone' ? 'ফোনে যাচাই' : 'অফিসিয়াল সূত্রে হালনাগাদ'}: {bnDate(h.verified)}</p>
        </section>

        <Faq items={faq} />
        <Report placeholder="যেমন: পরীক্ষার ফি বদলেছে" note="তথ্য পরিবর্তন হতে পারে। জরুরি প্রয়োজনে সরাসরি হাসপাতালে ফোন করুন।">
          {h.sources.length > 0 && (
            <div class="un-src"><b class="pf-h3" style="display:block;margin:4px 0 0">তথ্যসূত্র</b>
              <ul>{h.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.title}<Icon name="ext" size={14} /></a></li>)}</ul></div>
          )}
        </Report>
        <ShareRow />

        <nav class="pf-tags hp-tags" aria-label="সম্পর্কিত">
          <a href={`/hospitals/${h.city}/`}>{city.of} সব হাসপাতাল</a>
          <a href={`/doctors/${h.city}/`}>{city.of} ডাক্তার</a>
        </nav>

        <Ad />

        {near.length > 0 && (
          <section class="pf-block" aria-labelledby="h-near">
            <div class="pf-block-head"><h2 id="h-near">{city.of} অন্য হাসপাতাল</h2><a class="see-all" href={`/hospitals/${h.city}/`}>See All</a></div>
            <div class="pf-minis">
              {near.map((x) => (
                <a class="pf-mini" href={hospitalUrl(x)}><MiniThumb d={x.data} icon="build" />
                  <span class="pf-mini-txt"><b>{x.data.name}</b><span class="pf-mini-h"><Icon name="pin" size={12} />{x.data.address}</span></span>
                  <span class="pf-mini-go"><Icon name="chev" size={16} w={2.4} /></span></a>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="pf-side" aria-label="যোগাযোগ">
        <div class="pf-side-in">
          <div class="pf-sum">
            <b class="pf-sum-h">{er ? 'জরুরি ও সিরিয়াল নম্বর' : 'যোগাযোগের নম্বর'}</b>
            <div class="pf-sheet-grp">{h.numbers.map((n) => <NumRow label={n.label} number={n.number} note={n.note} er={n.kind === 'emergency'} />)}</div>
            <a class="pf-btn" href={map} target="_blank" rel="noopener"><Icon name="pin" />ম্যাপে দেখুন</a>
          </div>
          <Ad side />
        </div>
      </aside>
    </div>
  </main>

  <div class="pf-sheet un-page" data-sheet="numbers" hidden>
    <div class="pf-sheet-bg" data-sheet-close></div>
    <div class="pf-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sheet-h">
      <div class="pf-sheet-grip"></div>
      <div class="pf-sheet-top"><b id="sheet-h">{short} · নম্বর</b><button class="pf-sheet-x" type="button" data-sheet-close aria-label="বন্ধ করুন"><Icon name="x" w={2.4} /></button></div>
      <div class="pf-sheet-grp">{h.numbers.map((n) => <NumRow label={n.label} number={n.number} note={n.note} er={n.kind === 'emergency'} />)}</div>
    </div>
  </div>
</Base>

<script>
  import '../../../scripts/hospital.js';
</script>
