---
import Prose from '../layouts/Prose.astro';
import { CONTACT_EMAIL } from '../lib/site';
const toc = [
  { id: 'email', label: 'ইমেইলে যোগাযোগ' },
  { id: 'bhul', label: 'ভুল জানান' },
  { id: 'doctor', label: 'ডাক্তার বা হাসপাতাল হিসেবে' },
  { id: 'noy', label: 'যেসব বিষয়ে আমরা সাহায্য করতে পারি না' },
];
const bhulSubject = encodeURIComponent('তথ্য সংশোধন: [পাতার নাম লিখুন]');
const bhulBody = encodeURIComponent('পাতার লিংক:\n\nকী ভুল আছে:\n\nসঠিক তথ্য কী (জানা থাকলে):\n\nপ্রমাণ বা সূত্র (থাকলে):\n');
---
<Prose title="যোগাযোগ" description="InfoSaathi-র সঙ্গে যোগাযোগ করুন: পরামর্শ, তথ্য সংশোধন, ডাক্তার বা প্রতিষ্ঠানের তথ্য হালনাগাদের অনুরোধ জানানোর ঠিকানা।" path="/contact/" kicker="আমরা শুনতে চাই" type="ContactPage" toc={toc}
  lead="আপনার পরামর্শ, সংশোধন বা প্রশ্ন আমাদের কাছে মূল্যবান। নিচের ঠিকানায় লিখলে আমরা পড়ে দেখব।">

  <h2 id="email">ইমেইলে যোগাযোগ</h2>
  <p>সাধারণ যোগাযোগের জন্য লিখুন: <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a></p>
  <p>আমরা একটি ছোট দল, তাই উত্তর দিতে কিছু সময় লাগতে পারে। অনুগ্রহ করে ধৈর্য ধরবেন।</p>

  <h2 id="bhul">ভুল জানান</h2>
  <p>কোনো ডাক্তারের চেম্বারের সময়, ঠিকানা, ফোন নম্বর বা অন্য কোনো তথ্য ভুল দেখলে আমাদের জানান। পাঠানোর সময় এই বিষয়গুলো দিলে যাচাই দ্রুত হয়:</p>
  <ul>
    <li>যে পাতায় ভুল আছে তার লিংক</li>
    <li>কোন তথ্যটি ভুল এবং সঠিক তথ্য কী</li>
    <li>সম্ভব হলে প্রমাণ বা সূত্র, যেমন হাসপাতালের নোটিশ বা কার্ডের ছবি</li>
  </ul>
  <p><a class="ps-cta" href={`mailto:${CONTACT_EMAIL}?subject=${bhulSubject}&body=${bhulBody}`}>ইমেইলে ভুল জানান</a></p>
  <p>প্রতিটি অভিযোগ আমরা পড়ি এবং <a href="/verification/#songshodhon">সংশোধননীতি</a> অনুযায়ী যাচাই করে ঠিক করি।</p>

  <h2 id="doctor">ডাক্তার বা হাসপাতাল হিসেবে</h2>
  <p>আপনি যদি ডাক্তার বা হাসপাতালের প্রতিনিধি হন এবং আপনার তথ্য হালনাগাদ করতে চান, ইমেইলে সঠিক তথ্য ও সিরিয়ালের নম্বর জানান। আমরা ফোনে যাচাই করে হালনাগাদ করব। তথ্য সরিয়ে নেওয়ার অনুরোধ এলেও একইভাবে বিবেচনা করা হয়।</p>
  <div class="ps-note">তালিকায় জায়গা পেতে বা উপরে থাকতে কোনো অর্থ লাগে না, এবং আমরা তা নিইও না।</div>

  <h2 id="noy">যেসব বিষয়ে আমরা সাহায্য করতে পারি না</h2>
  <ul>
    <li>চিকিৎসা পরামর্শ, রোগ নির্ণয় বা ওষুধ সম্পর্কে সিদ্ধান্ত। এর জন্য সরাসরি রেজিস্টার্ড চিকিৎসকের সঙ্গে কথা বলুন।</li>
    <li>ডাক্তারের সিরিয়াল বুকিং। সিরিয়াল সরাসরি ডাক্তারের চেম্বার বা হাসপাতালের নম্বরে নিতে হয়।</li>
    <li>জরুরি অবস্থায় সাহায্য। জরুরি হলে নিকটস্থ হাসপাতালে যান অথবা ৯৯৯-এ ফোন করুন।</li>
  </ul>
</Prose>
