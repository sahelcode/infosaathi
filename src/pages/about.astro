---
import { Image } from 'astro:assets';
import Prose from '../layouts/Prose.astro';
import { CONTACT_EMAIL } from '../lib/site';
import { bn } from '../lib/format';
import { getDoctors, getHospitals, getUniversities, getInstitutions, instSection, getHotels, getScholarships, getJobs, getNews } from '../lib/data';
import doctorIcon from '../assets/pill-icons/doctor.png';
import hospitalIcon from '../assets/pill-icons/hospital.png';
import universityIcon from '../assets/pill-icons/university.png';
import collegeIcon from '../assets/pill-icons/college.png';
import madrasaIcon from '../assets/pill-icons/madrasa.png';
import hotelsIcon from '../assets/pill-icons/hotels.png';
import scholarshipIcon from '../assets/pill-icons/scholarship.png';
import jobsIcon from '../assets/pill-icons/jobs.png';
import newsIcon from '../assets/pill-icons/news.png';

// The numbers are counted from the published data, so they are never out of date.
const inst = await getInstitutions();
const n = {
  doctors: (await getDoctors()).length,
  hospitals: (await getHospitals()).length,
  universities: (await getUniversities()).length,
  colleges: inst.filter((i) => instSection(i) === 'college').length,
  madrasas: inst.filter((i) => instSection(i) === 'madrasa').length,
  hotels: (await getHotels()).length,
  scholarships: (await getScholarships()).length,
  jobs: (await getJobs()).length,
  news: (await getNews()).length,
};
const c = (v: number, unit: string) => (v > 0 ? `${bn(v)}টি ${unit}` : 'শীঘ্রই আসছে');
const tiles = [
  { icon: doctorIcon, name: 'ডাক্তার', sub: n.doctors ? `${bn(n.doctors)} জন` : 'শীঘ্রই আসছে', href: '/doctors/' },
  { icon: hospitalIcon, name: 'হাসপাতাল', sub: c(n.hospitals, 'প্রোফাইল'), href: '/hospitals/' },
  { icon: universityIcon, name: 'বিশ্ববিদ্যালয়', sub: c(n.universities, 'প্রোফাইল'), href: '/universities/' },
  { icon: collegeIcon, name: 'কলেজ', sub: c(n.colleges, 'কলেজ'), href: '/colleges/' },
  { icon: madrasaIcon, name: 'মাদরাসা', sub: c(n.madrasas, 'মাদরাসা'), href: '/madrasas/' },
  { icon: hotelsIcon, name: 'হোটেল', sub: c(n.hotels, 'হোটেল'), href: '/hotels/' },
  { icon: scholarshipIcon, name: 'বৃত্তি', sub: c(n.scholarships, 'বৃত্তি'), href: '/scholarships/' },
  { icon: jobsIcon, name: 'চাকরি', sub: c(n.jobs, 'বিজ্ঞপ্তি'), href: '/jobs/' },
  { icon: newsIcon, name: 'খবর', sub: c(n.news, 'খবর'), href: '/news/' },
];
---
<Prose title="আমাদের সম্পর্কে" description="InfoSaathi বাংলাদেশের ডাক্তার, হাসপাতাল, শিক্ষাপ্রতিষ্ঠান, চাকরি, বৃত্তি ও সরকারি সেবার তথ্য সূত্র ও তারিখসহ এক জায়গায় রাখার একটি স্বতন্ত্র উদ্যোগ। জানুন আমাদের কাজের নীতি।" path="/about/" kicker="পরিচিতি" type="AboutPage" bare wide
  lead="InfoSaathi বাংলাদেশের মানুষের জন্য একটি তথ্যের ঠিকানা। ডাক্তার, হাসপাতাল, পড়াশোনা, চাকরি, ঘোরাঘুরি ও সরকারি সেবার দরকারি তথ্য এক জায়গায়, সূত্র ও তারিখসহ।">

  <section class="ab-sec" id="ki-ache">
    <h2>এখানে কী আছে</h2>
    <p class="ab-sub">সংখ্যাগুলো সাইটে এখন প্রকাশিত পাতা থেকে গোনা।</p>
    <div class="ab-tiles">
      {tiles.map((t) => (
        <a class="ab-tile" href={t.href}>
          <Image src={t.icon} width={88} height={88} alt="" loading="lazy" />
          <span><b>{t.name}</b><span>{t.sub}</span></span>
        </a>
      ))}
    </div>
    <div class="ab-chips">
      <a href="/places/">দর্শনীয় স্থান</a><a href="/ai-tools/">এআই টুলস</a><a href="/services/">সরকারি সেবা</a><a href="/rankings/">বিশ্ববিদ্যালয় র‍্যাঙ্কিং</a><a href="/apps/">অ্যাপ</a><a href="/blood/">রক্তদাতা সংগঠন</a>
    </div>
  </section>

  <section class="ab-sec" id="keno">
    <h2>কেন InfoSaathi</h2>
    <p>অনলাইনে দরকারি তথ্য প্রায়ই পুরোনো, অসম্পূর্ণ বা একটা আরেকটার সঙ্গে মেলে না। ভুল তথ্যে কেউ দূর থেকে এসে ফিরে যান, কেউ বন্ধ নম্বরে বারবার ফোন করেন। আমরা তথ্য এক জায়গায় রাখি, আর কোন তথ্য কবে ও কোথা থেকে যাচাই হয়েছে তা পাশে লিখে দিই।</p>
  </section>

  <section class="ab-sec" id="niti">
    <h2>আমাদের তিনটি নিয়ম</h2>
    <div class="ab-cards c3">
      <div class="ab-card"><h3>সূত্র ও তারিখ</h3><p>প্রতিটি পাতায় তথ্যের সূত্র ও যাচাইয়ের তারিখ থাকে। যাচাই হয়নি, এমন তথ্য যাচাই হয়েছে বলে দেখানো হয় না।</p></div>
      <div class="ab-card"><h3>টাকায় অবস্থান কেনা যায় না</h3><p>কোনো ডাক্তার, হাসপাতাল বা প্রতিষ্ঠান অর্থ দিয়ে তালিকায় উপরে ওঠে না।</p></div>
      <div class="ab-card"><h3>ভুল হলে ঠিক করি</h3><p>ভুল জানালে আমরা আবার যাচাই করে পাতা ঠিক করি। প্রমাণ না পেলে সন্দেহজনক অংশ সরিয়ে রাখি।</p></div>
    </div>
    <p style="margin-top:14px">পুরো পদ্ধতি লেখা আছে <a href="/verification/">তথ্য যেভাবে যাচাই করি</a> পাতায়।</p>
  </section>

  <section class="ab-sec" id="utsho">
    <h2>তথ্য কোথা থেকে আসে</h2>
    <div class="ab-cards c2">
      <div class="ab-card"><h3>ডাক্তার</h3><p>চেম্বারের সময়, ঠিকানা ও সিরিয়ালের নম্বর আমরা নিজে ফোন করে মিলিয়ে নিই। ফোনে যাচাই না হলে পাতা প্রকাশ হয় না।</p></div>
      <div class="ab-card"><h3>হাসপাতাল, শিক্ষাপ্রতিষ্ঠান ও বাকি সব</h3><p>অফিসিয়াল ওয়েবসাইট ও নির্ভরযোগ্য খোলা সূত্র থেকে। এই কাজে আমরা এআই-সহায়তায় সূত্র খুঁজি ও পড়ি। সূত্রে মেলানো না গেলে সেই তথ্য বসাই না, পাতায় লেখা থাকে "আমরা সঠিক তথ্য পাইনি"। কোন তথ্য কোন ধরনের সূত্রের, তা প্রতিটি পাতার ব্যাজে দেখানো থাকে।</p></div>
    </div>
  </section>

  <section class="ab-sec" id="nai">
    <h2>আমরা যা নই</h2>
    <p>আমরা কোনো ডাক্তার, হাসপাতাল, বিশ্ববিদ্যালয়, সরকারি সংস্থা বা অন্য কোনো প্রতিষ্ঠানের প্রতিনিধি নই। সরকারি সেবার পাতাগুলো গাইড, সরকারি সাইট নয়। আমরা চিকিৎসা পরামর্শ, চাকরি, বৃত্তি বা ভর্তি দিই না, বুকিং বা আবেদনও নিই না। আবেদন সবসময় সংশ্লিষ্ট প্রতিষ্ঠানের অফিসিয়াল সাইটে করুন। বিস্তারিত <a href="/disclaimer/">তথ্যের দায়মুক্তি</a> পাতায়।</p>
  </section>

  <section class="ab-sec" id="biggapon">
    <h2>বিজ্ঞাপন</h2>
    <p>সাইট চালানোর খরচ মেটাতে আমরা গুগলের মতো বিজ্ঞাপন সেবা ব্যবহার করতে পারি। বিজ্ঞাপন কোনো তালিকার অবস্থান বদলায় না। বিজ্ঞাপন আলাদাভাবে দেখানো হয় এবং তা আমাদের সুপারিশ নয়। জানুন <a href="/ads-and-cookies/">বিজ্ঞাপন ও কুকি নীতি</a> পাতায়।</p>
  </section>

  <section class="ab-sec" id="poricalona">
    <h2>কারা চালান</h2>
    <p>InfoSaathi সিলেট থেকে পরিচালিত একটি স্বতন্ত্র উদ্যোগ। প্রতিষ্ঠাতা ও সম্পাদক: <strong>সাহেল আহমেদ</strong>।</p>
    <div class="ps-note">আমরা এখনও বাড়ছি, তাই কিছু পাতায় তথ্য অসম্পূর্ণ থাকতে পারে। সংখ্যার চেয়ে নির্ভুলতাকে আমরা বেশি গুরুত্ব দিই।</div>
  </section>

  <section class="ab-sec" id="jogajog">
    <div class="ab-cta">
      <p>ভুল দেখলে বা পরামর্শ থাকলে জানান। ইমেইল: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <a class="ps-cta" href="/contact/">যোগাযোগ করুন</a>
    </div>
  </section>
</Prose>
