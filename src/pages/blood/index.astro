---
import Base from '../../layouts/Base.astro';
import BloodOrgs from '../../components/BloodOrgs.astro';
import { getBloodOrgs } from '../../lib/data';
import { districtBn, GROUPS, slugOf } from '../../lib/blood';
import { bn } from '../../lib/format';
import { SITE } from '../../lib/site';
import '../../styles/hospital.css';
import '../../styles/uni.css';
import '../../styles/blood.css';
const orgs = await getBloodOrgs();
const counts = new Map<string, number>();
for (const o of orgs) counts.set(o.data.district, (counts.get(o.data.district) ?? 0) + 1);
const upaMap: Record<string, string[]> = {};
for (const o of orgs) { const a = (upaMap[o.data.district] ??= []); if (!a.includes(o.data.upazila)) a.push(o.data.upazila); }
for (const k in upaMap) upaMap[k].sort((x, y) => x.localeCompare(y, 'bn'));
const districts = [...counts].sort((a, b) => districtBn(a[0]).localeCompare(districtBn(b[0]), 'bn'));
const jsonld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['হোম', '/'], ['রক্তদাতা সংস্থা', '/blood/']].map(([n, l], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + l })) };
---
<Base title="রক্তদাতা সংস্থা: জেলা ও উপজেলা অনুযায়ী ফোন ও ফেসবুক গ্রুপ | InfoSaathi" description="বাংলাদেশের জেলা ও উপজেলা অনুযায়ী রক্তদাতা সংস্থার ফোন নম্বর, ঠিকানা ও ফেসবুক গ্রুপ।" path="/blood/" jsonld={jsonld}>
  <main class="pf"><div class="bo">
    <nav class="pf-crumbs" aria-label="ব্রেডক্রাম্ব"><a href="/">হোম</a><span>›</span><a href="/blood/">রক্তদাতা সংস্থা</a></nav>
    <h1 class="pf-list-h">রক্তদাতা সংস্থা</h1>
    <p class="pf-list-intro">জেলা ও উপজেলা অনুযায়ী রক্তদাতা সংস্থার ফোন নম্বর, ঠিকানা ও ফেসবুক গ্রুপ। প্রতিটি তথ্যের পাশে লেখা আছে কবে ও কীভাবে যাচাই হয়েছে।</p>
    <form class="bo-filter" id="boFilter" onsubmit="return false" data-map={JSON.stringify(upaMap)}>
      <label class="bo-sel"><span>জেলা</span>
        <select id="boDist" aria-label="জেলা"><option value="">সব জেলা</option>{districts.map(([k]) => <option value={k}>{districtBn(k)}</option>)}</select></label>
      <label class="bo-sel"><span>উপজেলা</span>
        <select id="boUpa" aria-label="উপজেলা" disabled><option value="">সব উপজেলা</option></select></label>
    </form>
    <nav class="bo-dist bo-groupnav" aria-label="রক্তের গ্রুপ">{GROUPS.map((g) => <a href={`/blood/${slugOf(g)}/`}>{g}</a>)}</nav>
    {orgs.length > 0 ? <BloodOrgs orgs={orgs} showDistrict /> : <p class="bo-empty">রক্তদাতা সংস্থার তালিকা তৈরি হচ্ছে। যাচাই করা তথ্য পেলেই এখানে যোগ হবে।</p>}
    <p class="bo-empty" id="boNone" hidden>এই এলাকার যাচাই করা তথ্য এখনও যোগ হয়নি, ইনশাআল্লাহ শীঘ্রই আসছে।</p>
  </div></main>
  <script is:inline>
    (function(){
      var f=document.getElementById('boFilter'); if(!f) return;
      var map=JSON.parse(f.dataset.map||'{}'), d=document.getElementById('boDist'), u=document.getElementById('boUpa'), none=document.getElementById('boNone');
      var groups=[].slice.call(document.querySelectorAll('.bo-grp'));
      function apply(){
        var dv=d.value, uv=u.value, shown=0;
        groups.forEach(function(g){ var ok=(!dv||g.dataset.d===dv)&&(!uv||g.dataset.u===uv); g.hidden=!ok; if(ok) shown++; });
        none.hidden=shown>0;
      }
      d.addEventListener('change',function(){
        u.innerHTML='<option value="">সব উপজেলা</option>';
        var list=map[d.value]||[];
        list.forEach(function(x){ var o=document.createElement('option'); o.value=x; o.textContent=x; u.appendChild(o); });
        u.disabled=!d.value; apply();
      });
      u.addEventListener('change',apply);
    })();
  </script>
</Base>
