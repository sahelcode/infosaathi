---
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL, SITE } from '../../lib/site';
import '../../styles/hospital.css';
import '../../styles/uni.css';
import '../../styles/blood.css';
const subject = 'রক্তদাতা হিসেবে যুক্ত হতে চাই';
const body = [
  'নাম:',
  'রক্তের গ্রুপ:',
  'জেলা ও উপজেলা:',
  'ফোন নম্বর:',
  'শেষ রক্ত দেওয়ার তারিখ (মনে থাকলে):',
  '',
  'আমি জানি আমার নাম, রক্তের গ্রুপ, এলাকা ও ফোন নম্বর InfoSaathi-তে প্রকাশ হতে পারে। আমি এতে রাজি। যেকোনো সময় লিখে জানালে তা সরানো হবে।',
].join('\n');
const href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const path = '/blood/join/';
const jsonld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['হোম', '/'], ['রক্তদাতা সংস্থা', '/blood/'], ['ডোনার হিসেবে যুক্ত হন', path]].map(([n, l], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + l })) };
---
<Base title="রক্তদাতা হিসেবে যুক্ত হন | InfoSaathi" description="স্বেচ্ছায় রক্ত দিতে চান? নিজের সম্মতিতে নাম লেখান। যাচাইয়ের পর আপনার অনুমতি নিয়েই শুধু তথ্য প্রকাশ করা হবে।" path={path} jsonld={jsonld}>
  <main class="pf"><div class="bo">
    <nav class="pf-crumbs" aria-label="ব্রেডক্রাম্ব"><a href="/">হোম</a><span>›</span><a href="/blood/">রক্তদাতা সংস্থা</a><span>›</span><a href={path}>যুক্ত হন</a></nav>
    <h1 class="pf-list-h">রক্তদাতা হিসেবে যুক্ত হন</h1>
    <p class="pf-list-intro">রক্ত লাগার সময় সবচেয়ে বড় সমস্যা হলো দাতা খুঁজে পাওয়া। আপনার একটি ফোন কল কারও জীবন বাঁচাতে পারে। নিজের ইচ্ছায়, নিজের সম্মতিতে নাম লেখান।</p>

    <section class="bd-card">
      <h2>কীভাবে হবে</h2>
      <ol class="bd-steps">
        <li>নিচের বাটনে চাপলে আপনার ইমেইল অ্যাপ খুলবে। নাম, রক্তের গ্রুপ, উপজেলা ও ফোন নম্বর লিখে পাঠান।</li>
        <li>আমরা আপনাকে ফোন করে তথ্য যাচাই করব।</li>
        <li>যাচাইয়ের পর শুধু আপনার অনুমতি থাকলেই তথ্য প্রকাশ হবে।</li>
      </ol>
      <a class="bd-join" href={href}><span class="bd-join-d" aria-hidden="true"></span>ইমেইলে তথ্য পাঠান</a>
      <p class="bd-note">ইমেইল অ্যাপ না থাকলে {CONTACT_EMAIL} ঠিকানায় নিজে লিখুন।</p>
    </section>

    <section class="bd-card">
      <h2>আপনার অধিকার</h2>
      <p>আমরা কারও ফোন নম্বর অনুমতি ছাড়া প্রকাশ করি না। প্রকাশের পরও যেকোনো সময় লিখে জানালে আপনার তথ্য সরিয়ে দেওয়া হবে। প্রকাশ হলে নাম, রক্তের গ্রুপ, এলাকা ও ফোন নম্বর দেখা যাবে। এর বাইরে কিছু নয়।</p>
      <p>আপনার তথ্য শুধু রক্তদানের কাজে ব্যবহার হবে, অন্য কাউকে বিক্রি বা হস্তান্তর করা হবে না।</p>
    </section>

    <section class="bd-card">
      <h2>রক্ত দেওয়ার আগে যা জানা দরকার</h2>
      <p>সাধারণত ১৮ থেকে ৬০ বছর বয়সী সুস্থ মানুষ রক্ত দিতে পারেন। শেষ রক্তদানের অন্তত তিন মাস পর আবার দেওয়া যায়। রক্ত দেওয়ার আগে হাসপাতাল বা ব্লাড সেন্টার আপনাকে পরীক্ষা করে নেবে।</p>
    </section>
  </div></main>
</Base>
