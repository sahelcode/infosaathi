---
import Prose from '../layouts/Prose.astro';
import { CONTACT_EMAIL } from '../lib/site';
const toc = [
  { id: 'chikitsa', label: 'এটি চিকিৎসা পরামর্শ নয়' },
  { id: 'joruri', label: 'জরুরি অবস্থায় কী করবেন' },
  { id: 'doctor', label: 'ডাক্তারের তালিকা সম্পর্কে' },
  { id: 'tothyo', label: 'তথ্য বদলাতে পারে' },
  { id: 'fee', label: 'ফি ও সময়' },
  { id: 'poramorsho', label: 'আপনার করণীয়' },
];
---
<Prose title="চিকিৎসা তথ্যের দায়মুক্তি" description="InfoSaathi-র তথ্য চিকিৎসা পরামর্শ নয়। ডাক্তারের তালিকা, চেম্বারের সময় ও ফি সংক্রান্ত তথ্যের সীমাবদ্ধতা এবং আপনার করণীয় জানুন।" path="/disclaimer/" kicker="গুরুত্বপূর্ণ বিজ্ঞপ্তি" toc={toc}
  lead="এই সাইটের তথ্য কেবল সাধারণ জ্ঞাতার্থে। এটি কোনোভাবেই চিকিৎসকের পরামর্শের বিকল্প নয়।">

  <h2 id="chikitsa">এটি চিকিৎসা পরামর্শ নয়</h2>
  <p>InfoSaathi-তে প্রকাশিত কোনো লেখা, তালিকা বা তথ্য রোগ নির্ণয়, চিকিৎসা বা ওষুধের পরামর্শ নয়। আপনার স্বাস্থ্য নিয়ে যেকোনো সিদ্ধান্তের আগে একজন নিবন্ধিত চিকিৎসকের সঙ্গে সরাসরি কথা বলুন। সাইটে কিছু পড়েছেন বলে চিকিৎসকের পরামর্শ নিতে দেরি করবেন না বা তা উপেক্ষা করবেন না।</p>

  <h2 id="joruri">জরুরি অবস্থায় কী করবেন</h2>
  <div class="ps-note warn">শ্বাসকষ্ট, বুকে তীব্র ব্যথা, অজ্ঞান হয়ে যাওয়া, প্রচণ্ড রক্তক্ষরণ, খিঁচুনি বা এমন কোনো জরুরি অবস্থায় এই সাইটে সময় নষ্ট করবেন না। সঙ্গে সঙ্গে নিকটস্থ হাসপাতালের জরুরি বিভাগে যান অথবা ৯৯৯-এ ফোন করুন।</div>

  <h2 id="doctor">ডাক্তারের তালিকা সম্পর্কে</h2>
  <ul>
    <li>কোনো ডাক্তারকে তালিকাভুক্ত করা মানে আমরা তাঁর চিকিৎসার মান, দক্ষতা বা ফলাফলের নিশ্চয়তা দিচ্ছি না।</li>
    <li>"যাচাই করা" চিহ্নের অর্থ চেম্বারের তথ্য (সময়, ঠিকানা, নম্বর) মিলিয়ে দেখা হয়েছে। এটি ডাক্তারের যোগ্যতার সনদ নয়।</li>
    <li>তালিকার ক্রম কোনো র‍্যাঙ্কিং বা সুপারিশ নয়। কোনো ডাক্তার অর্থ দিয়ে এখানে ওপরে ওঠেন না।</li>
    <li>আমরা কোনো ডাক্তার, হাসপাতাল বা ওষুধ কোম্পানির প্রতিনিধি বা অনুমোদিত প্রচারক নই।</li>
    <li>ডাক্তার বেছে নেওয়ার দায়িত্ব রোগী বা তাঁর পরিবারের। প্রয়োজনে একাধিক চিকিৎসকের মত নিন এবং বিএমডিসি নিবন্ধন যাচাই করুন।</li>
  </ul>

  <h2 id="tothyo">তথ্য বদলাতে পারে</h2>
  <p>ডাক্তারদের বসার দিন, সময়, ছুটি, হাসপাতাল ও সিরিয়ালের নম্বর যেকোনো সময় বদলে যেতে পারে। আমরা প্রতিটি পাতায় সর্বশেষ যাচাইয়ের তারিখ দেখাই, কিন্তু সেই তারিখের পরে হওয়া পরিবর্তন আমাদের জানা নাও থাকতে পারে।</p>

  <h2 id="fee">ফি ও সময়</h2>
  <p>কোনো ফি বা সময় উল্লেখ থাকলে তা শুধু ধারণা দেওয়ার জন্য। চূড়ান্ত ফি ও সময় সংশ্লিষ্ট চেম্বার বা হাসপাতাল নির্ধারণ করে। যাওয়ার আগে সিরিয়ালের নম্বরে ফোন করে নিশ্চিত হয়ে নিন।</p>

  <h2 id="poramorsho">আপনার করণীয়</h2>
  <ol>
    <li>যাওয়ার আগে চেম্বারে ফোন করে দিন, সময় ও ফি নিশ্চিত করুন।</li>
    <li>ডাক্তারের নিবন্ধন (BMDC) ও যোগ্যতা নিজে যাচাই করে নিন।</li>
    <li>তথ্যে ভুল পেলে আমাদের জানান: <a href="/contact/#bhul">ভুল জানান</a> অথবা <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>।</li>
  </ol>
  <p>আরও জানতে পড়ুন <a href="/verification/">তথ্য যেভাবে যাচাই করি</a> এবং <a href="/terms/">ব্যবহারের শর্ত</a>।</p>
</Prose>
