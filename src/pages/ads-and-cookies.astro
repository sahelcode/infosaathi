import { CONTACT_EMAIL } from '../lib/site';
const toc = [
  { id: 'ekhon', label: 'বর্তমান অবস্থা' },
  { id: 'bigyapon', label: 'বিজ্ঞাপন কীভাবে কাজ করে' },
  { id: 'cookie', label: 'কুকি কী ও কেন' },
  { id: 'niyontron', label: 'আপনার নিয়ন্ত্রণ' },
  { id: 'swadhinota', label: 'সম্পাদকীয় স্বাধীনতা' },
  { id: 'khabar', label: 'স্বাস্থ্যবিষয়ক বিজ্ঞাপন' },
];
---
<Prose title="বিজ্ঞাপন ও কুকি নীতি" description="InfoSaathi-তে বিজ্ঞাপন কীভাবে দেখানো হতে পারে, কুকি কী কাজে লাগে এবং আপনি কীভাবে বিজ্ঞাপন ও কুকি নিয়ন্ত্রণ করতে পারেন।" path="/ads-and-cookies/" kicker="নীতিমালা" toc={toc}
  lead="সাইট চালানোর খরচ মেটাতে আমরা বিজ্ঞাপন ব্যবহার করতে পারি। এই পাতায় জানানো হলো বিজ্ঞাপন ও কুকি কীভাবে কাজ করে এবং আপনার হাতে কী নিয়ন্ত্রণ আছে।">

  <h2 id="ekhon">বর্তমান অবস্থা</h2>
  <p>InfoSaathi একটি স্বাধীন সাইট এবং আয়ের জন্য ভবিষ্যতে Google AdSense-এর মতো বিজ্ঞাপন সেবা ব্যবহার করতে পারে। বিজ্ঞাপন চালু হলে এই পাতায় তা জানানো হবে। এই নীতি তখনকার জন্যও প্রযোজ্য।</p>

  <h2 id="bigyapon">বিজ্ঞাপন কীভাবে কাজ করে</h2>
  <p>তৃতীয় পক্ষের বিজ্ঞাপন সেবা (যেমন Google) আমাদের সাইটে বিজ্ঞাপন দেখাতে পারে। এসব সেবা আপনার ব্রাউজারে কুকি বা অনুরূপ প্রযুক্তি ব্যবহার করে আপনার এই সাইটে ও অন্যান্য সাইটে আগের পরিদর্শনের ভিত্তিতে আপনার আগ্রহ অনুযায়ী বিজ্ঞাপন দেখাতে পারে। বিজ্ঞাপন সরবরাহকারীরা যে তথ্য সংগ্রহ করে, তার ওপর আমাদের নিয়ন্ত্রণ নেই; তা তাদের নিজস্ব নীতি অনুযায়ী পরিচালিত হয়।</p>
  <ul>
    <li>আমরা বিজ্ঞাপনদাতাকে আপনার নাম, ফোন নম্বর বা ইমেইল দিই না।</li>
    <li>বিজ্ঞাপন সাধারণত "বিজ্ঞাপন" লেবেলসহ আলাদাভাবে দেখানো হয়। কোনো বিজ্ঞাপনকে আমাদের সুপারিশ হিসেবে ধরবেন না।</li>
  </ul>

  <h2 id="cookie">কুকি কী ও কেন</h2>
  <p>কুকি হলো ওয়েবসাইট দেখার সময় আপনার ব্রাউজারে জমা হওয়া ছোট তথ্যের ফাইল। এগুলো সাধারণত চারটি কাজে লাগে:</p>
  <div class="ps-badges">
    <div class="ps-badge"><b>অত্যাবশ্যক</b><span>সাইট নিরাপদ ও সঠিকভাবে চালাতে প্রয়োজনীয়।</span></div>
    <div class="ps-badge"><b>পরিসংখ্যান</b><span>কোন পাতা কত ব্যবহৃত হচ্ছে বোঝার জন্য (বর্তমানে আমরা এমন কোনো সেবা ব্যবহার করি না)।</span></div>
    <div class="ps-badge"><b>বিজ্ঞাপন</b><span>বিজ্ঞাপন দেখানো, তার সীমা ঠিক রাখা এবং কার্যকারিতা মাপার জন্য, তৃতীয় পক্ষের সেবা এগুলো সেট করে।</span></div>
  </div>

  <h2 id="niyontron">আপনার নিয়ন্ত্রণ</h2>
  <ul>
    <li><strong>ব্রাউজারের সেটিংস:</strong> প্রায় সব ব্রাউজারে কুকি মুছে ফেলা বা বন্ধ করা যায়। তবে কিছু কুকি বন্ধ করলে সাইটের কিছু অংশ ঠিকমতো না-ও চলতে পারে।</li>
    <li><strong>বিজ্ঞাপনের ব্যক্তিগতকরণ:</strong> Google-এর বিজ্ঞাপন সেটিংস (adssettings.google.com) থেকে আপনি ব্যক্তিগতকৃত বিজ্ঞাপন বন্ধ করতে পারেন।</li>
    <li><strong>অন্য পক্ষের বিকল্প:</strong> aboutads.info-এর মতো সাইটে বিভিন্ন সরবরাহকারীর ব্যক্তিগতকৃত বিজ্ঞাপন একসঙ্গে বন্ধ করার সুযোগ আছে।</li>
  </ul>
  <p>বিজ্ঞাপন বন্ধ করলেও বিজ্ঞাপন দেখা যেতে পারে, তবে তা আপনার আগ্রহ অনুযায়ী সাজানো থাকবে না।</p>

  <h2 id="swadhinota">সম্পাদকীয় স্বাধীনতা</h2>
  <p>বিজ্ঞাপন আমাদের আয়ের উৎস হলেও তা আমাদের তথ্যের ওপর প্রভাব ফেলে না। কোনো ডাক্তার বা প্রতিষ্ঠান বিজ্ঞাপনের বিনিময়ে তালিকায় এগিয়ে যান না। বিস্তারিত দেখুন <a href="/verification/#adnotice">তথ্য যেভাবে যাচাই করি</a> পাতায়।</p>

  <h2 id="khabar">স্বাস্থ্যবিষয়ক বিজ্ঞাপন</h2>
  <p>চিকিৎসা-সম্পর্কিত পাতায় যে বিজ্ঞাপন আসে তা আমাদের পরামর্শ নয়। কোনো ওষুধ, পণ্য বা সেবার বিজ্ঞাপন দেখে চিকিৎসকের পরামর্শ ছাড়া সিদ্ধান্ত নেবেন না। আপত্তিকর বা বিভ্রান্তিকর বিজ্ঞাপন দেখলে আমাদের জানান: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>।</p>
  <p>আমাদের তথ্য-ব্যবহার সম্পর্কে আরও জানতে পড়ুন <a href="/privacy/">গোপনীয়তা নীতি</a>।</p>
</Prose>
