---
// Doctor profile. Everything on this page comes from one file in src/content/doctors/.
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Avatar from '../../../components/Avatar.astro';
import NumRow from '../../../components/NumRow.astro';
import Faq from '../../../components/Faq.astro';
import Report from '../../../components/Report.astro';
import ShareRow from '../../../components/ShareRow.astro';
import Ad from '../../../components/Ad.astro';
import MiniDoctor from '../../../components/MiniDoctor.astro';
import { getDoctors, getHospitals, doctorUrl, hospitalUrl, doctorsAt, type Doctor } from '../../../lib/data';
import { CITIES, SPECIALTIES } from '../../../lib/taxonomy';
import { DAYS, DAY_JS, DAY_SHORT, bn, taka, phoneShow, phoneIntl, daysText, daysSchema, timeRange, bnDate, bnMonth, isoDay } from '../../../lib/format';
import { SITE } from '../../../lib/site';
import '../../../styles/doctor.css';

export async function getStaticPaths() {
  const doctors = await getDoctors();
  return doctors.map((d) => ({ params: { city: d.data.city, slug: d.id }, props: { doctor: d } }));
}

const { doctor } = Astro.props as { doctor: Doctor };
const d = doctor.data;
const city = CITIES[d.city];
const sp = SPECIALTIES[d.specialty];
const spTitle = d.title ?? sp.bn;
const path = doctorUrl(doctor);

const doctors = await getDoctors();
const visibleHospitals = await getHospitals();
const allHospitals = new Map((await getCollection('hospitals')).map((h) => [h.id, h]));
const linkable = new Set(visibleHospitals.map((h) => h.id));

// Each chamber with its place name, address, link and map resolved from the hospital file when there is one.
const chambers = d.chambers.map((c, i) => {
  const h = c.hospital ? allHospitals.get(c.hospital.id) : undefined;
  const name = c.name ?? h!.data.name;
  const address = c.address ?? h!.data.address;
  const href = h && linkable.has(h.id) ? hospitalUrl(h) : undefined;
  const map = c.map ?? h?.data.map ?? `https://maps.google.com/?q=${encodeURIComponent(name + ', ' + address)}`;
  return { ...c, i, key: `ch${i + 1}`, h, name, address, href, map, days: c.days ?? [], timeText: c.start && c.end ? timeRange(c.start, c.end) : 'সময় যাচাই বাকি',
    daysTxt: c.days ? daysText(c.days) : 'দিন যাচাই বাকি' };
});
const first = chambers[0];
// a draft may still lack numbers; the published site always has them (the schema makes sure)
const firstSerial = chambers.flatMap((c) => c.serials)[0] ?? { label: 'সিরিয়াল', number: '', note: undefined };

// ---- English side of the page (people search in both languages) ----
const DAY_EN: Record<string, string> = { শনি: 'Saturday', রবি: 'Sunday', সোম: 'Monday', মঙ্গল: 'Tuesday', বুধ: 'Wednesday', বৃহস্পতি: 'Thursday', শুক্র: 'Friday' };
const DAY_EN3: Record<string, string> = { শনি: 'Sat', রবি: 'Sun', সোম: 'Mon', মঙ্গল: 'Tue', বুধ: 'Wed', বৃহস্পতি: 'Thu', শুক্র: 'Fri' };
const t12 = (t: string) => { const [h, m] = t.split(':').map(Number); return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; };
// "Sat–Thu" when the days are one run of the week (Sat..Fri order), otherwise a plain list
const daysEn = (ds: readonly string[]) => {
  const idx = ds.map((x) => DAYS.indexOf(x as never)).sort((a, b) => a - b);
  const run = idx.length > 2 && idx.every((v, i) => i === 0 || v === idx[i - 1] + 1);
  const n = (i: number) => DAY_EN3[DAYS[i]];
  return run ? `${n(idx[0])}–${n(idx[idx.length - 1])}` : idx.map(n).join(', ');
};
const enPlace = (c: (typeof chambers)[number]) => c.h?.data.name_en ?? c.name;
const enTime = (c: (typeof chambers)[number]) => (c.start && c.end ? `${t12(c.start)} – ${t12(c.end)}` : '');
const enLine = (c: (typeof chambers)[number]) => `${enPlace(c)}${c.days.length ? ` · ${daysEn(c.days)}` : ''}${enTime(c) ? ` · ${enTime(c)}` : ''}`;

// ---- text written from the data ----
const workDays = new Set(chambers.flatMap((c) => c.days));
const offDays = DAYS.filter((x) => !workDays.has(x));
const placeLine = (c: (typeof chambers)[number]) => `${c.name}-এ ${c.daysTxt} ${c.timeText}`;
const about =
  d.about ??
  `${d.name} ${city.of} একজন ${spTitle}।${d.designation ? ` ${d.designation}।` : ''} বর্তমানে ${chambers.map((c) => c.name).join(' ও ')}-এ রোগী দেখেন।`;

const feeText = (f: NonNullable<(typeof chambers)[number]['fee']>) =>
  [f.visit && `ভিজিট ${taka(f.visit)}`, f.new && `নতুন রোগী ${taka(f.new)}`, f.old && `পুরনো রোগী ${taka(f.old)}`, f.report && `রিপোর্ট দেখাতে ${taka(f.report)}`].filter(Boolean).join(', ');
const feeChamber = chambers.find((c) => c.fee);

const faq = [
  {
    q: `${d.name}-এর সিরিয়াল কীভাবে নেব?`,
    a: `${first.name}-এর জন্য ${phoneShow(firstSerial.number)} নম্বরে ${firstSerial.note ? firstSerial.note + ' ' : ''}কল করে সিরিয়াল নিন।` +
      (chambers.length > 1 ? ' প্রতিটা চেম্বারের নম্বর ওপরের চেম্বার অংশে আলাদা দেওয়া আছে।' : ''),
  },
  {
    q: `${d.name} কোন দিন রোগী দেখেন?`,
    a: chambers.map(placeLine).join('। ') + '।' + (offDays.length ? ` ${offDays.map((x) => x + 'বার').join(', ')} বন্ধ।` : ''),
  },
  { q: `${d.name}-এর চেম্বার কোথায়?`, a: chambers.map((c) => `${c.name}: ${c.address}${c.room ? ', ' + c.room : ''}`).join('। ') + '।' },
  { q: `${d.name}-এর ভিজিট ফি কত?`, a: feeChamber ? `${feeChamber.name}-এ ${feeText(feeChamber.fee!)}।` : `ফি আমরা এখনো যুক্ত করিনি। সঠিক ফি জানতে ${phoneShow(firstSerial.number)} নম্বরে কল করুন।` },
  ...d.faq,
];

// ---- related lists ----
const others = doctors.filter((x) => x.id !== doctor.id);
const evenCut = <T,>(a: T[], max: number) => { const r = a.slice(0, max); return r.length % 2 && r.length > 1 ? r.slice(0, -1) : r; };
// No view counts exist yet, so the order is: most recently phone-verified first (fair, and it rewards checked data).
const fresh = (a: Doctor[]) => [...a].sort((x, y) => +y.data.verified - +x.data.verified);
const mainHosp = chambers.find((c) => c.href)?.h;
const sameSpAll = fresh(others.filter((x) => x.data.specialty === d.specialty && x.data.city === d.city));
// "Related" = same specialty in the same city, up to 4, shown before the hospital's doctors. Hidden while there are none.
const sameSp = sameSpAll.slice(0, 4);
const sideSp = sameSpAll.slice(0, 3);
const shown = new Set(sameSp.map((x) => x.id));
const sameHosp = mainHosp ? evenCut(fresh(doctorsAt(others, mainHosp.id)).filter((x) => !shown.has(x.id)), 4) : [];
const usedHosp = new Set(chambers.map((c) => c.h?.id));
const nearHosp = visibleHospitals.filter((h) => h.data.city === d.city && !usedHosp.has(h.id)).slice(0, 3);
const placeOf = (x: Doctor) => {
  const c = x.data.chambers[0];
  const n = c.name ?? allHospitals.get(c.hospital!.id)?.data.short ?? allHospitals.get(c.hospital!.id)?.data.name;
  return `${n}, ${CITIES[x.data.city].bn}`;
};

// ---- search engines ----
const photo = d.photo ? await getImage({ src: d.photo, width: 400, height: 400, format: 'webp' }) : undefined;
const banner = d.banner ? await getImage({ src: d.banner, width: 1000, format: 'webp' }) : undefined;
const enAbout = `${d.name_en} is a ${sp.en} specialist in ${city.en}, Bangladesh.${d.bmdc ? ` BMDC registration: ${d.bmdc}.` : ''} Chamber: ${chambers.map(enLine).join('; ')}. For an appointment call ${phoneShow(firstSerial.number).replace(/[০-৯]/g, (x) => '০১২৩৪৫৬৭৮৯'.indexOf(x) + '')}.`;
// Title: both names + both specialty words, so Bangla and English searches both match. Description repeats the real chamber facts.
const titleSp = spTitle.length <= 40 ? spTitle : sp.bn; // the card's own wording (e.g. "মেডিসিন ও হৃদরোগ বিশেষজ্ঞ") finds more searches
const title = `${d.name} (${d.name_en}) – ${titleSp} | ${sp.en}, ${city.en}`;
// Google cuts descriptions near 155 characters, so the parts are added in order of value and the rest is dropped.
const descParts = [
  `${d.name} (${d.name_en}), ${spTitle}, ${city.bn}।`,
  `চেম্বার: ${first.name}`,
  first.start ? `${first.daysTxt} ${first.timeText}।` : '',
  `সিরিয়াল: ${phoneShow(firstSerial.number)}।`,
  `ঠিকানা: ${first.address}`,
];
let description = '';
for (const part of descParts) {
  const next = (description + ' ' + part).trim();
  if (next.length > 155) break;
  description = next;
}
if (!description) description = `${d.name}, ${spTitle}, ${city.bn}। চেম্বার, সময় ও সিরিয়াল নম্বর।`;
const crumbs = [
  ['হোম', '/'],
  ['ডাক্তার', '/doctors/'],
  [city.bn, `/doctors/${d.city}/`],
  [sp.bn, `/doctors/${d.city}/${d.specialty}/`],
];
const multi = chambers.length > 1;
const Wrap: any = multi ? 'details' : 'div';
const Head: any = multi ? 'summary' : 'div';
const daysEn3 = (c: (typeof chambers)[number]) => c.daysTxt.replace('বৃহস্পতি', 'বৃহঃ').replace(/\s*–\s*/g, '–');
const daysShort = first.daysTxt.replace('বৃহস্পতি', 'বৃহঃ').replace(/\s*–\s*/g, '–');
const waNum = d.whatsapp ? phoneIntl(d.whatsapp).replace(/\D/g, '') : undefined;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Physician', 'MedicalBusiness'],
      '@id': SITE + path + '#doctor',
      name: d.name_en,
      alternateName: [d.name, ...d.aliases],
      description: enAbout,
      url: SITE + path,
      medicalSpecialty: sp.schema,
      ...(photo && { image: new URL(photo.src, SITE).href }),
      telephone: chambers.flatMap((c) => c.serials).map((s) => phoneIntl(s.number)),
      address: { '@type': 'PostalAddress', streetAddress: first.address, addressLocality: city.en, addressCountry: 'BD' },
      areaServed: { '@type': 'City', name: city.en },
      knowsLanguage: ['bn', 'en'],
      ...(d.treats.length && { knowsAbout: d.treats }),
      ...(d.bmdc && { identifier: { '@type': 'PropertyValue', propertyID: 'BMDC', value: d.bmdc } }),
      hasCredential: d.degrees.map((x) => ({ '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: x })),
      hospitalAffiliation: chambers.filter((c) => c.h).map((c) => ({ '@type': 'Hospital', name: c.h!.data.name_en })),
      openingHoursSpecification: chambers.filter((c) => c.days.length && c.start && c.end).map((c) => ({
        '@type': 'OpeningHoursSpecification', dayOfWeek: c.days.map((x) => DAY_EN[x]), opens: c.start, closes: c.end,
      })),
      ...((feeChamber?.fee?.visit ?? feeChamber?.fee?.new) && { priceRange: `BDT ${feeChamber?.fee?.visit ?? feeChamber?.fee?.new}` }),
      isAccessibleForFree: false,
    },
    { '@type': 'WebPage', '@id': SITE + path, url: SITE + path, name: title, description, inLanguage: ['bn', 'en'], about: { '@id': SITE + path + '#doctor' },
      ...(d.verified && { dateModified: isoDay(d.verified) }) },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + u })) },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---
<Base title={title} description={description} path={path} ogType="profile" ogImage={banner?.src ?? photo?.src} jsonld={jsonld} draft={d.draft}>
  <main class="pf dx">
    <nav class="pf-crumbs" aria-label="ব্রেডক্রাম্ব">
      {crumbs.map(([n, u], i) => (<>{i > 0 && <span>›</span>}<a href={u}>{n}</a></>))}
    </nav>

    <div class="pf-grid">
      <article class="pf-main">
        <section class="dx-hero" aria-labelledby="dx-name">
          <div class="dx-float" aria-hidden="true">
            <svg class="f1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5 3.5 13.5a4.95 4.95 0 0 1 7-7l7 7a4.95 4.95 0 0 1-7 7Z"/><path d="m8.5 8.5 7 7"/></svg>
            <svg class="f2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z"/></svg>
            <svg class="f3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3v6a5 5 0 0 0 10 0V3"/><path d="M9 14v2a5 5 0 0 0 10 0v-1"/><circle cx="19" cy="12" r="2.2"/></svg>
            <svg class="f4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l2.5-6 4 12 2.5-6H22"/></svg>
            <svg class="f5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-5.2-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.8-8 11-8 11Z"/></svg>
            <svg class="f6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.2 6 10.5a6 6 0 0 1-12 0C6 9.2 12 3 12 3Z"/></svg>
          </div>
          <div class="dx-top">
            <div class="dx-avcol">
              <div class="dx-av">{d.photo ? <Image src={d.photo} alt={`${d.name} (${d.name_en})`} width={112} height={112} loading="eager" fetchpriority="high" /> : <Avatar seed={d.name} size={112} />}</div>
              {d.bmdc && <span class="dx-bmdc">BMDC {d.bmdc}</span>}
            </div>
            <div class="dx-id">
              <span class="pf-today dx-status" data-today hidden></span>
              <h1 id="dx-name" class="dx-name">{d.name}<span class="dx-en" lang="en">{d.name_en}</span></h1>
              <p class="dx-sp"><b>{spTitle}</b> <em lang="en">{sp.en}</em></p>
              <p class="dx-deg">{d.degrees.join(' · ')}</p>
            </div>
          </div>
          {d.designation && <p class="dx-post">{d.designation}</p>}
          <div class="dx-meta">
            <span class="dx-chip">{d.area ? `${d.area}, ` : ''}{city.bn} <i lang="en">{city.en}</i></span>
            {chambers.length > 1
              ? <span class="dx-chip">{bn(chambers.length)}টি চেম্বার</span>
              : <>
                  {first.days.length > 0 && <span class="dx-chip">{daysShort}</span>}
                  {first.start && <span class="dx-chip">{first.timeText}</span>}
                </>}
          </div>
          <div class="dx-acts">
            <button class="dx-act pri" type="button" data-sheet-open="numbers"><Icon name="phone" size={16} />সিরিয়াল নিন</button>
            <a class="dx-act" href={first.map} target="_blank" rel="noopener"><Icon name="route" size={16} />ম্যাপ</a>
            <button class="dx-act" type="button" data-share><Icon name="share" size={16} />শেয়ার</button>
          </div>
        </section>

        {d.notice && (
          <div class="pf-notice" data-from={isoDay(d.notice.from)} data-until={isoDay(d.notice.to)}>
            <span class="pf-notice-i"><Icon name="bell" /></span>
            <p><b>নোটিশ</b>{d.notice.text}</p>
          </div>
        )}

        <section class="pf-card dx-card" id="chambers" aria-labelledby="h-chamber">
          <div class="pf-card-head"><h2 id="h-chamber">চেম্বার ও সিরিয়াল <small lang="en">Chamber &amp; Appointment</small></h2></div>
          {chambers.map((c) => (
            <Wrap class:list={['pf-chamber', 'dx-ch', { 'dx-multi': multi }]} open={multi && c.i === 0 ? true : undefined} id={c.key} data-chamber={c.key} data-days={c.start ? c.days.map((x) => DAY_JS[x]).join(',') : undefined} data-start={c.start} data-end={c.end}>
              <Head class="dx-ch-head">
                {chambers.length > 1 && <span class="pf-ch-no">{bn(c.i + 1)}</span>}
                <div class="dx-ch-txt">
                  <a class="dx-ch-name" href={c.href ?? c.map} target={c.href ? undefined : '_blank'} rel={c.href ? undefined : 'noopener'}><b>{c.name}</b>{c.href && <Icon name="chev" size={15} w={2.4} />}</a>
                  <span class="pf-ch-addr">{c.address}{c.room && ` · ${c.room}`}</span>
                </div>
                <span class="pf-live" data-live hidden></span>
                {multi && <span class="dx-ch-toggle" aria-hidden="true"><Icon name="down" size={18} w={2.2} /></span>}
                {multi && <span class="dx-ch-sub">{c.days.length > 0 ? daysEn3(c) : ''}{c.start ? ` · ${c.timeText}` : ''}</span>}
              </Head>
              <dl class="dx-facts">
                <div><dt><Icon name="cal" size={15} />দিন</dt><dd><div class="pf-days">{DAYS.map((x) => <span class:list={['pf-day', { on: c.days.includes(x) }]} data-d={DAY_JS[x]}>{DAY_SHORT[x]}</span>)}</div></dd></div>
                <div><dt><Icon name="clock" size={15} />সময়</dt><dd class="pf-v">{c.timeText}</dd></div>
                <div><dt><Icon name="cash" size={15} />ফি</dt>{c.fee ? (
                  <dd class="dx-fee">
                    {c.fee.visit && <span>ভিজিট <b>{taka(c.fee.visit)}</b></span>}
                    {c.fee.new && <span>নতুন <b>{taka(c.fee.new)}</b></span>}
                    {c.fee.old && <span>পুরনো <b>{taka(c.fee.old)}</b></span>}
                    {c.fee.report && <span>রিপোর্ট <b>{taka(c.fee.report)}</b></span>}
                  </dd>
                ) : <dd class="dx-fee na">কল করে জানুন</dd>}</div>
              </dl>
              <div class="pf-nums">{c.serials.map((s) => <NumRow label={s.label} number={s.number} note={s.note} />)}</div>
              <a class="pf-maplink" href={c.map} target="_blank" rel="noopener"><Icon name="route" size={16} />ম্যাপে দেখুন · Get directions</a>
            </Wrap>
          ))}
          <p class="dx-verified"><Icon name="check" size={14} w={2.8} />{d.verified_by === 'phone' ? 'ফোনে যাচাই করা' : 'অফিসিয়াল সূত্রে হালনাগাদ'} · {bnDate(d.verified)}</p>
        </section>

        <section class="pf-card dx-card" aria-labelledby="h-about">
          <h2 id="h-about">পরিচিতি <small lang="en">About</small></h2>
          <p class="pf-text">{about}</p>
          <p class="pf-text dx-enp" lang="en">{enAbout}</p>
          {d.treats.length > 0 && (<><h3 class="pf-h3">যে রোগের চিকিৎসা করেন</h3><div class="pf-chips">{d.treats.map((t) => <span>{t}</span>)}</div></>)}
        </section>

        {d.banner && (
          <section class="pf-card dx-card pf-bannercard" aria-labelledby="h-banner">
            <div class="pf-card-head"><h2 id="h-banner">ভিজিটিং কার্ড <small lang="en">Visiting card</small></h2>{d.banner_month && <span class="pf-count">{bnMonth(d.banner_month)}</span>}</div>
            <button class="pf-banner" type="button" data-zoom aria-label="চেম্বার কার্ড বড় করে দেখুন">
              <Image src={d.banner} width={1000} alt={`${d.name} (${d.name_en}) – ${spTitle}, ${first.name}, রোগী দেখার সময় ${first.timeText}, সিরিয়াল ${phoneShow(firstSerial.number)}`} />
            </button>
            <div class="dx-imgbtns">
              <button class="dx-imgshare" type="button" data-img-share data-name={`${d.name_en} visiting card`}><Icon name="share" size={17} />শেয়ার করুন</button>
              <button class="dx-imgshare" type="button" data-img-dl data-name={`${d.name_en} visiting card`}><Icon name="download" size={17} />ডাউনলোড</button>
            </div>
            <p class="pf-banner-note">হাসপাতাল থেকে পাওয়া কার্ড। ওপরের তথ্য আমরা ফোন করে আলাদা করে যাচাই করি।</p>
          </section>
        )}

        <Faq items={faq} />

        <Report placeholder="যেমন: চেম্বারের সময় বদলেছে" note="তথ্য পরিবর্তন হতে পারে। চেম্বারে যাওয়ার আগে ফোন করে নিশ্চিত হয়ে নিন।" />

        <ShareRow copy />

        <nav class="pf-tags" aria-label="সম্পর্কিত">
          <a href={`/doctors/${d.city}/${d.specialty}/`}>{city.in} {sp.bn}</a>
          {mainHosp && <a href={hospitalUrl(mainHosp)}>{mainHosp.data.short ?? mainHosp.data.name}</a>}
          {mainHosp && <a href={hospitalUrl(mainHosp) + '#doctors'}>এই হাসপাতালের ডাক্তার</a>}
          <a href={`/doctors/${d.city}/`}>{city.of} সব ডাক্তার</a>
        </nav>

        <Ad />

        {sameSp.length > 0 && (
          <section class="pf-block dx-mob" aria-labelledby="h-rel">
            <div class="pf-block-head"><h2 id="h-rel">একই বিশেষজ্ঞতার অন্য ডাক্তার</h2><a class="see-all" href={`/doctors/${d.city}/${d.specialty}/`}>See All</a></div>
            <div class="pf-minis">{sameSp.map((x) => <MiniDoctor doctor={x} place={placeOf(x)} />)}</div>
          </section>
        )}
        {mainHosp && sameHosp.length > 0 && (
          <section class="pf-block" aria-labelledby="h-same">
            <div class="pf-block-head"><h2 id="h-same">{mainHosp.data.short ?? mainHosp.data.name}-এর অন্য ডাক্তার</h2><a class="see-all" href={hospitalUrl(mainHosp) + '#doctors'}>See All</a></div>
            <div class="pf-minis">{sameHosp.map((x) => <MiniDoctor doctor={x} place={placeOf(x)} />)}</div>
          </section>
        )}
      </article>

      <aside class="pf-side" aria-label="আরও">
        <div class="pf-side-in">
          {sideSp.length > 0 && (
            <section class="dx-side-card" aria-labelledby="h-side-sp">
              <b id="h-side-sp">{city.in} আরও {sp.bn}</b>
              <div class="pf-minis">{sideSp.map((x) => <MiniDoctor doctor={x} place={placeOf(x)} />)}</div>
              <a class="dx-side-all" href={`/doctors/${d.city}/${d.specialty}/`}>সব {sp.bn} দেখুন<Icon name="chev" size={15} w={2.4} /></a>
            </section>
          )}
          {nearHosp.length > 0 && (
            <div class="pf-near">
              <b>{city.of} অন্য হাসপাতাল</b>
              {nearHosp.map((h) => <a href={hospitalUrl(h)}>{h.data.name}<Icon name="chev" size={14} w={2.4} /></a>)}
            </div>
          )}
        </div>
      </aside>
    </div>
  </main>

  <div class="pf-sticky dx-bar" aria-label="দ্রুত যোগাযোগ">
    <button class="pf-btn primary" type="button" data-sheet-open="numbers"><Icon name="phone" />সিরিয়াল নিন</button>
    <a class="pf-btn" href={first.map} target="_blank" rel="noopener"><Icon name="route" />ম্যাপ</a>
    {waNum && <a class="pf-btn wa" href={`https://wa.me/${waNum}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="wa" size={20} w={1.8} /></a>}
  </div>

  <div class="pf-sheet" data-sheet="numbers" hidden>
    <div class="pf-sheet-bg" data-sheet-close></div>
    <div class="pf-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sheet-h">
      <div class="pf-sheet-grip"></div>
      <div class="pf-sheet-top"><b id="sheet-h">সিরিয়াল নিন · {d.name}</b><button class="pf-sheet-x" type="button" data-sheet-close aria-label="বন্ধ করুন"><Icon name="x" w={2.4} /></button></div>
      {chambers.map((c) => (
        <div class="pf-sheet-grp"><span class="pf-sheet-h">{c.name}</span>{c.serials.map((s) => <NumRow label={s.label} number={s.number} note={s.note} />)}</div>
      ))}
      {waNum && <a class="pf-btn wa dx-sheet-wa" href={`https://wa.me/${waNum}`} target="_blank" rel="noopener"><Icon name="wa" size={19} w={1.8} />WhatsApp-এ মেসেজ করুন</a>}
    </div>
  </div>

  {d.banner && (
    <div class="pf-zoom" data-zoombox hidden>
      <button class="pf-zoom-x" type="button" data-zoom-close aria-label="বন্ধ করুন"><Icon name="x" size={22} w={2.4} /></button>
      <img alt="" data-zoom-img />
    </div>
  )}
</Base>
