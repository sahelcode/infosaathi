---
import Prose from '../layouts/Prose.astro';
import { CONTACT_EMAIL } from '../lib/site';
const toc = [
  { id: 'poricoy', label: 'সংক্ষেপে' },
  { id: 'ki-sngroho', label: 'আমরা কী তথ্য সংগ্রহ করি' },
  { id: 'ki-kori-na', label: 'যা আমরা করি না' },
  { id: 'tritiyo', label: 'তৃতীয় পক্ষের সেবা' },
  { id: 'cookie', label: 'কুকি' },
  { id: 'kobhar', label: 'তথ্য কীভাবে ব্যবহার হয়' },
  { id: 'dhore', label: 'তথ্য সংরক্ষণ' },
  { id: 'odhikar', label: 'আপনার অধিকার' },
  { id: 'shishu', label: 'শিশুদের তথ্য' },
  { id: 'bodol', label: 'নীতি পরিবর্তন' },
];
---
<Prose title="গোপনীয়তা নীতি" description="InfoSaathi ওয়েবসাইট ব্যবহার করলে কোন তথ্য সংগ্রহ হয়, কীভাবে ব্যবহার হয় এবং আপনার গোপনীয়তা কীভাবে সুরক্ষিত থাকে তার বিবরণ।" path="/privacy/" kicker="নীতিমালা" toc={toc}
  lead="আপনার গোপনীয়তাকে আমরা গুরুত্ব দিই। এই পাতায় সহজ ভাষায় লেখা আছে InfoSaathi ব্যবহারের সময় কোন তথ্য সংগ্রহ হয় এবং তা দিয়ে কী করা হয়।">

  <h2 id="poricoy">সংক্ষেপে</h2>
  <ul>
    <li>InfoSaathi ব্যবহারের জন্য অ্যাকাউন্ট খুলতে বা নাম-ফোন নম্বর দিতে হয় না।</li>
    <li>আমরা আপনার তথ্য বিক্রি করি না।</li>
    <li>সাইটে যোগাযোগের কোনো ফর্ম নেই। ইমেইল পাঠালে সেই ইমেইলের তথ্যই শুধু আমাদের কাছে আসে।</li>
  </ul>

  <h2 id="ki-sngroho">আমরা কী তথ্য সংগ্রহ করি</h2>
  <h3>১. স্বয়ংক্রিয়ভাবে পাওয়া কারিগরি তথ্য</h3>
  <p>যেকোনো ওয়েবসাইটের মতো আমাদের সাইট ব্যবহারের সময় আপনার ব্রাউজার ও ডিভাইসের কিছু কারিগরি তথ্য সার্ভারে পৌঁছায়, যেমন আইপি অ্যাড্রেস, ব্রাউজারের ধরন, ডিভাইসের ধরন, দেখা পাতা এবং সময়। এই তথ্য সাইট নিরাপদ ও সচল রাখতে এবং নকশা উন্নত করতে ব্যবহৃত হয়। সাইটটি Cloudflare-এর মাধ্যমে পরিবেশিত হয়, তাই এই কারিগরি লগ Cloudflare-এর সেবার অংশ হিসেবে প্রক্রিয়াজাত হতে পারে।</p>
  <h3>২. আপনি নিজে পাঠালে</h3>
  <p>আপনি ইমেইলে আমাদের সঙ্গে যোগাযোগ করলে আপনার ইমেইল ঠিকানা, নাম (দিলে) এবং বার্তার বিষয়বস্তু আমাদের কাছে আসে। শুধু আপনার প্রশ্ন বা সংশোধনের অনুরোধ নিয়ে কাজ করতে এগুলো ব্যবহার করা হয়।</p>
  <h3>৩. ব্রাউজারে সাময়িক ব্যবহার</h3>
  <p>নম্বর কপি বা লিংক শেয়ারের মতো সুবিধা আপনার ডিভাইসের ব্রাউজারেই কাজ করে। এই কাজে আপনার ব্যক্তিগত তথ্য আমাদের সার্ভারে পাঠানো হয় না।</p>

  <h2 id="ki-kori-na">যা আমরা করি না</h2>
  <ul>
    <li>আপনার ব্যক্তিগত তথ্য বিক্রি বা ভাড়া দিই না।</li>
    <li>স্বাস্থ্যসংক্রান্ত তথ্য, রোগের বিবরণ বা চিকিৎসার ইতিহাস চাই না, সংগ্রহও করি না।</li>
    <li>আপনি কোন ডাক্তার খুঁজছেন, সেই তথ্য আপনার পরিচয়ের সঙ্গে জুড়ে রাখি না।</li>
  </ul>

  <h2 id="tritiyo">তৃতীয় পক্ষের সেবা</h2>
  <p>সাইটটি সঠিকভাবে চালাতে কিছু বাইরের সেবা ব্যবহৃত হয়। এসব সেবা তাদের নিজস্ব নীতিতে আপনার কিছু কারিগরি তথ্য (যেমন আইপি অ্যাড্রেস) পেতে পারে।</p>
  <div class="ps-scroll"><table class="ps-table">
    <thead><tr><th>সেবা</th><th>কেন ব্যবহৃত</th></tr></thead>
    <tbody>
      <tr><td>Cloudflare</td><td>সাইট হোস্টিং, দ্রুত পরিবেশন ও নিরাপত্তা</td></tr>
      <tr><td>Google Fonts</td><td>লেখার ফন্ট লোড করা</td></tr>
      <tr><td>Google Maps (লিংক)</td><td>চেম্বারের ঠিকানার মানচিত্র আপনি নিজে খুললে</td></tr>
      <tr><td>Google AdSense (ভবিষ্যতে)</td><td>বিজ্ঞাপন দেখানো হলে। বিস্তারিত <a href="/ads-and-cookies/">বিজ্ঞাপন ও কুকি নীতিতে</a></td></tr>
    </tbody>
  </table></div>
  <p>এই সেবাগুলোর নিজস্ব গোপনীয়তা নীতি আছে, যা তাদের ওয়েবসাইটে দেখা যায়। বাইরের সাইটের লিংকে গেলে সেই সাইটের নীতি প্রযোজ্য হবে।</p>

  <h2 id="cookie">কুকি</h2>
  <p>কুকি হলো আপনার ব্রাউজারে সংরক্ষিত ছোট ফাইল। বর্তমানে সাইট নিজে বিশ্লেষণ বা ট্র্যাকিংয়ের জন্য কুকি ব্যবহার করে না। ভবিষ্যতে বিজ্ঞাপন বা পরিসংখ্যান যুক্ত হলে কুকির ব্যবহার বদলাতে পারে এবং তখন তা <a href="/ads-and-cookies/">বিজ্ঞাপন ও কুকি নীতি</a> পাতায় হালনাগাদ করা হবে।</p>

  <h2 id="kobhar">তথ্য কীভাবে ব্যবহার হয়</h2>
  <ul>
    <li>সাইট সচল, নিরাপদ ও দ্রুত রাখতে।</li>
    <li>আপনার পাঠানো প্রশ্ন বা সংশোধনের অনুরোধের উত্তর দিতে।</li>
    <li>সাইটের কোন অংশ বেশি কাজে লাগছে বুঝে তা আরও ভালো করতে।</li>
    <li>আইনি বাধ্যবাধকতা মানতে।</li>
  </ul>

  <h2 id="dhore">তথ্য সংরক্ষণ</h2>
  <p>ইমেইলে পাঠানো তথ্য প্রয়োজনের চেয়ে বেশি সময় আমরা সংরক্ষণ করি না। সম্পূর্ণ নিরাপত্তার নিশ্চয়তা কোনো ইন্টারনেট সেবাই দিতে পারে না, তবে আমরা যুক্তিসংগত সতর্কতা নিই।</p>

  <h2 id="odhikar">আপনার অধিকার</h2>
  <p>আপনি আমাদের কাছে পাঠানো নিজের তথ্য দেখতে, সংশোধন করতে বা মুছে ফেলতে অনুরোধ করতে পারেন। এছাড়া আপনি যদি ডাক্তার বা প্রতিষ্ঠানের প্রতিনিধি হন এবং আপনার প্রকাশিত তথ্য সংশোধন বা সরানোর অনুরোধ করতে চান, সেটিও জানাতে পারেন। অনুরোধ পাঠান <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> ঠিকানায়।</p>

  <h2 id="shishu">শিশুদের তথ্য</h2>
  <p>এই সাইট প্রধানত প্রাপ্তবয়স্কদের জন্য। আমরা জেনেশুনে ১৩ বছরের কম বয়সী শিশুদের ব্যক্তিগত তথ্য সংগ্রহ করি না।</p>

  <h2 id="bodol">নীতি পরিবর্তন</h2>
  <p>সাইটের সুবিধা বা আইনের পরিবর্তনে এই নীতি হালনাগাদ হতে পারে। প্রতিবার পাতার ওপরে "সর্বশেষ হালনাগাদ" তারিখ বদলে যাবে। প্রশ্ন থাকলে যোগাযোগ করুন: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>।</p>
</Prose>
