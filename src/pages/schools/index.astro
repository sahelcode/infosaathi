---
import ListPage from '../../components/ListPage.astro';
import Icon from '../../components/Icon.astro';
import { getInstitutions, institutionUrl, instSection } from '../../lib/data';
import { CITIES } from '../../lib/taxonomy';
import { bn } from '../../lib/format';
const list = (await getInstitutions()).filter((i) => instSection(i) === 'school');
const cities = [...new Set(list.map((i) => i.data.city))];
---
<ListPage title="বাংলাদেশের স্কুল: ভর্তি, EIIN ও যোগাযোগ | InfoSaathi" h1="স্কুল" path="/schools/" crumbs={[['হোম', '/']]}
  intro="স্কুল ও স্কুল অ্যান্ড কলেজের ভর্তি, EIIN, শিফট ও যোগাযোগ।"
  chips={cities.map((c) => ({ href: `/schools/${c}/`, label: CITIES[c].bn, n: bn(list.filter((i) => i.data.city === c).length) }))}>
  {list.map((i) => (
    <a class="pf-mini" href={institutionUrl(i)}><span class="hp-near-i un-rel-i"><Icon name="cap" size={20} w={1.8} /></span>
      <span class="pf-mini-txt"><b>{i.data.name_bn}</b><span class="pf-mini-h"><Icon name="pin" size={12} />{CITIES[i.data.city].bn} · {i.data.type}</span></span>
      <span class="pf-mini-go"><Icon name="chev" size={16} w={2.4} /></span></a>
  ))}
</ListPage>
