---
// Simple list page frame: breadcrumb, heading, intro, chips, then the list in the default slot.
import Base from '../layouts/Base.astro';
import { SITE, ADS_LIVE, SHOW_DRAFTS } from '../lib/site';
import Ad from './Ad.astro';
import '../styles/hospital.css';
import '../styles/uni.css';
interface Props { title: string; h1: string; intro: string; path: string; crumbs: string[][]; chips?: { href: string; label: string; n?: string }[] }
const { title, h1, intro, path, crumbs, chips = [] } = Astro.props;
const showAd = ADS_LIVE || SHOW_DRAFTS;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...crumbs, [h1, path]].map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + u })),
};
---
<Base title={title} description={intro} path={path} jsonld={jsonld}>
  <main class="pf">
    <nav class="pf-crumbs" aria-label="ব্রেডক্রাম্ব">{crumbs.map(([n, u]) => (<><a href={u}>{n}</a><span>›</span></>))}<a href={path}>{h1}</a></nav>
    <h1 class="pf-list-h">{h1}</h1>
    <p class="pf-list-intro">{intro}</p>
    <slot name="filter" />
    {chips.length > 0 && <nav class="pf-list-chips">{chips.map((c) => <a href={c.href}>{c.label}{c.n && <span>{c.n}</span>}</a>)}</nav>}
    <div class="pf-minis" id="pfList">
      <slot />
    </div>
    {showAd && <div class="pf-ad-mid" id="pfAdMid"><Ad /></div>}
    {showAd && <script is:inline>(function(){var l=document.getElementById('pfList'),a=document.getElementById('pfAdMid');if(!l||!a)return;var r=l.querySelectorAll('.pf-mini');if(r.length>12){r[11].after(a);}else{a.remove();}})();</script>}
    <button class="pf-more" id="pfMore" type="button" hidden>আরও দেখুন</button>
    {showAd && <Ad />}
  </main>
</Base>
<script>
  // First 30 rows, then "আরও দেখুন" adds 30 more. Works together with the dropdown filters.
  const STEP = 30;
  const list = document.getElementById('pfList');
  const more = document.getElementById('pfMore') as HTMLButtonElement | null;
  if (list && more) {
    let limit = STEP;
    const render = () => {
      const rows = [...list.querySelectorAll<HTMLElement>('.pf-mini')].filter((r) => !r.hidden);
      rows.forEach((r, i) => r.classList.toggle('pg-off', i >= limit));
      more.hidden = rows.length <= limit;
    };
    more.addEventListener('click', () => { limit += STEP; render(); });
    document.getElementById('lfForm')?.addEventListener('change', () => setTimeout(() => { limit = STEP; render(); }, 0));
    render();
  }
</script>
<style is:global>
  .pf-minis > .pf-ad-mid{grid-column:1 / -1;width:100%}
  .pf-ad-mid .ad-slot{margin-top:0}
</style>
