---
// Drawn stand-in face for a doctor without a photo. The same name always gets the same face.
import { hashIndex } from '../lib/format';
interface Props { seed: string; size?: number }
const { seed, size = 52 } = Astro.props;
const i = hashIndex(seed, 6);
const skin = ['#F1C9A5', '#E0AC82', '#EBC7A0', '#D9A47A', '#F5D3B3', '#C68B63'][i];
const hair = ['#2B1B12', '#3A2A1E', '#151515', '#231815', '#4A2E1B', '#1C1C1C'][i];
const bg = ['#DCFCE7', '#D1FAE5', '#CCFBF1', '#E0F2E9', '#DDF7E8', '#D5F5E3'][i];
---
<svg viewBox="0 0 80 80" width={size} height={size} aria-hidden="true"><rect width="80" height="80" fill={bg} /><path d="M6 80c0-15 15-23 34-23s34 8 34 23Z" fill="#fff" /><path d="M31 58l9 13 9-13Z" fill="#16A34A" /><rect x="35" y="46" width="10" height="13" rx="4" fill={skin} /><ellipse cx="40" cy="36" rx="12" ry="14" fill={skin} /><path d="M27.5 36c-2-12 5-17 12.5-17 8 0 15 5 12.5 17-1-6-3-9-5-10-4 2-12 2-16 0-2 1-3.5 4-4 10Z" fill={hair} /><circle cx="35" cy="37" r="1.5" fill="#1f2937" /><circle cx="45" cy="37" r="1.5" fill="#1f2937" /><path d="M36 43q4 3 8 0" fill="none" stroke="#9A3412" stroke-width="1.3" stroke-linecap="round" /></svg>
