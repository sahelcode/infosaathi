---
import Icon from './Icon.astro';
interface Props { copy?: boolean }
const { copy = false } = Astro.props;
---
<section class="pf-share" aria-label="শেয়ার">
  <span class="pf-share-l">শেয়ার করুন</span>
  <a class="pf-sh wa" data-wa href="#" target="_blank" rel="noopener"><Icon name="wa" size={18} w={1.8} />WhatsApp</a>
  <a class="pf-sh fb" data-fb href="#" target="_blank" rel="noopener"><Icon name="fb" size={18} w={1.8} />Facebook</a>
  {copy && <button class="pf-sh cp" type="button" data-copy><Icon name="copy" size={18} w={1.8} />লিঙ্ক কপি</button>}
</section>
