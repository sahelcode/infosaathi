---
// Top block shared by scholarship, job, AI tool and service pages.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
interface Props {
  kind: 'sch' | 'job' | 'ai' | 'gov';
  icon: IconName;
  name: string;
  sub?: string;
  line?: string;
  badges: { text: string; ok?: boolean }[];
  action: { href: string; label: string; icon: IconName };
  jump: string[][];
  checked: string;
  logo?: ImageMetadata;
}
const { kind, name, sub, line, badges, action, checked, logo } = Astro.props;
import { Image } from 'astro:assets';
---
<section class="pf-hero hp-hero">
  {kind === 'ai' ? (
    <div class="mx-anim ai" aria-hidden="true"><span class="mx-ai-line"></span><span class="mx-ai-dots"><i></i><i></i><i></i></span><span class="mx-ai-bar"></span></div>
  ) : (
    <div class={`mx-anim ${kind}`} aria-hidden="true"><i></i><i></i><i></i><b></b></div>
  )}
  <div class="pf-hero-body mx-body">
    {kind === 'ai' && logo && <div class="mx-logo"><Image src={logo} alt="" width={120} height={120} /></div>}
    <h1 class="pf-name">{name}</h1>
    {sub && <p class="pf-en">{sub}</p>}
    {line && <p class="hp-addr">{kind === "job" && <Icon name="pin" size={15} w={2.2} />}{line}</p>}
    <div class="pf-badges">
      {badges.map((b) => b.ok ? <span class="pf-badge ok"><Icon name="check" size={13} w={3} />{b.text}</span> : <span class="pf-badge">{b.text}</span>)}
      <span class="pf-badge src"><Icon name="clock" size={13} w={2.2} />{checked}</span>
    </div>
  </div>
  <div class="pf-actions hp-actions mx-actions">
    <a class="pf-btn primary" href={action.href} target="_blank" rel="noopener"><Icon name={action.icon} size={17} w={2.2} />{action.label}</a>
    <button class="pf-btn" type="button" data-share aria-label="শেয়ার"><Icon name="share" /></button>
  </div>
</section>
