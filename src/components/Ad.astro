---
// One ad place. Live: only when ADSENSE_CLIENT and ADSENSE_SLOT are both set. Preview: a grey placeholder.
// An ad that Google leaves unfilled collapses (see the style), so no empty hole stays on the page.
import { ADSENSE_CLIENT, ADSENSE_SLOT, ADS_LIVE, SHOW_DRAFTS } from '../lib/site';
interface Props { side?: boolean }
const { side = false } = Astro.props;
---
{ADS_LIVE ? (
  <div class:list={['ad-slot', 'ad-live', { side }]} aria-label="বিজ্ঞাপন">
    <small>বিজ্ঞাপন</small>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={ADSENSE_SLOT} data-ad-format="horizontal" data-full-width-responsive="false"></ins>
  </div>
) : SHOW_DRAFTS ? (
  <div class:list={['ad-slot', { side }]} aria-label="বিজ্ঞাপন"><span>{side ? 'বিজ্ঞাপন · ৩০০×২৫০' : 'বিজ্ঞাপন'}</span></div>
) : null}
<style is:global>
  .ad-slot.ad-live{display:block;min-height:0;border:0;background:none;border-radius:0;text-align:center;overflow:hidden}
  .ad-slot.ad-live small{display:block;font-size:11px;color:#94a3b8;letter-spacing:.04em;margin-bottom:4px}
  .ad-slot.ad-live:has(ins[data-ad-status="unfilled"]){display:none}
  .pf-main .ad-slot.ad-live,.ad-slot.ad-live.side{min-height:0}
</style>
