---
// District + upazila selects. Filters the .bo-grp sections of the BloodOrgs list on the same page (client side).
import { districtBn } from '../lib/blood';
interface Props { districts: [string, number][]; upaMap: Record<string, string[]> }
const { districts, upaMap } = Astro.props;
---
<form class="bo-filter" id="boFilter" onsubmit="return false" data-map={JSON.stringify(upaMap)}>
  <label class="bo-sel"><span>জেলা</span>
    <select id="boDist" aria-label="জেলা"><option value="">সব জেলা</option>{districts.map(([k]) => <option value={k}>{districtBn(k)}</option>)}</select></label>
  <label class="bo-sel"><span>উপজেলা</span>
    <select id="boUpa" aria-label="উপজেলা" disabled><option value="">সব উপজেলা</option></select></label>
</form>
<p class="bo-empty" id="boNone" hidden>এই এলাকার যাচাই করা তথ্য এখনও যোগ হয়নি, ইনশাআল্লাহ শীঘ্রই আসছে।</p>
<script is:inline>
  (function(){
    var f=document.getElementById('boFilter'); if(!f) return;
    var map=JSON.parse(f.dataset.map||'{}'), d=document.getElementById('boDist'), u=document.getElementById('boUpa'), none=document.getElementById('boNone');
    function apply(){
      var groups=[].slice.call(document.querySelectorAll('.bo-grp')), dv=d.value, uv=u.value, shown=0;
      groups.forEach(function(g){ var ok=(!dv||g.dataset.d===dv)&&(!uv||g.dataset.u===uv); g.hidden=!ok; if(ok) shown++; });
      none.hidden=shown>0;
    }
    d.addEventListener('change',function(){
      u.innerHTML='<option value="">সব উপজেলা</option>';
      (map[d.value]||[]).forEach(function(x){ var o=document.createElement('option'); o.value=x; o.textContent=x; u.appendChild(o); });
      u.disabled=!d.value; apply();
    });
    u.addEventListener('change',apply);
  })();
</script>

<script is:inline>
  /* Custom dropdown on top of the native selects: same values and change events, nicer panel. */
  (function(){
    var boxes=[].slice.call(document.querySelectorAll('.bo-sel'));
    function close(except){ boxes.forEach(function(b){ if(b!==except) b.classList.remove('open'); }); }
    boxes.forEach(function(box){
      var sel=box.querySelector('select'); if(!sel) return;
      box.classList.add('enh');
      var btn=document.createElement('button'); btn.type='button'; btn.className='bo-btn'; btn.setAttribute('aria-haspopup','listbox'); btn.setAttribute('aria-expanded','false');
      var panel=document.createElement('div'); panel.className='bo-panel'; panel.setAttribute('role','listbox');
      box.appendChild(btn); box.appendChild(panel);
      function sync(){
        btn.textContent=sel.options[sel.selectedIndex]?sel.options[sel.selectedIndex].textContent:'';
        btn.disabled=sel.disabled; box.classList.toggle('dis',sel.disabled);
      }
      function build(){
        panel.innerHTML='';
        [].slice.call(sel.options).forEach(function(o,i){
          var it=document.createElement('button'); it.type='button'; it.setAttribute('role','option');
          it.className='bo-opt'+(i===sel.selectedIndex?' on':''); it.textContent=o.textContent;
          it.addEventListener('click',function(){ sel.selectedIndex=i; sel.dispatchEvent(new Event('change',{bubbles:true})); sync(); box.classList.remove('open'); btn.setAttribute('aria-expanded','false'); btn.focus(); });
          panel.appendChild(it);
        });
      }
      btn.addEventListener('click',function(e){
        e.stopPropagation(); if(sel.disabled) return;
        var open=!box.classList.contains('open'); close(box);
        if(open){ build(); box.classList.add('open'); var on=panel.querySelector('.on'); if(on) panel.scrollTop=on.offsetTop-8; }
        else box.classList.remove('open');
        btn.setAttribute('aria-expanded',String(open));
      });
      sel.addEventListener('change',sync);
      new MutationObserver(sync).observe(sel,{attributes:true,attributeFilter:['disabled']});
      sync();
    });
    document.addEventListener('click',function(){ close(); });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  })();
</script>
